{
  "ci": {
    "collect": {
      "staticDistDir": "docs",
      "numberOfRuns": 3,
      "url": [
        "/index.html",
        "/mount-prospect-60056/index.html",
        "/mount-prospect-60056/this-weekend/index.html",
        "/sponsor/index.html",
        "/mount-prospect-60056/things-to-do/index.html",
        "/mount-prospect-60056/guides/fall-family-guide/index.html",
        "/mount-prospect-60056/directory/index.html"
      ]
    },
    "assert": {
      "assertions": {
        "largest-contentful-paint": ["error", { "maxNumericValue": 2500 }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.1 }],
        "total-blocking-time": ["error", { "maxNumericValue": 200 }]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}
