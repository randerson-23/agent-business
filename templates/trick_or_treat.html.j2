{% from "_signup.html.j2" import signup_css, signup_form, signup_runtime -%}
<!--
  ROADMAP.md Phase 11 #101 - the single highest-volume hyperlocal query
  of Q4, and one no competitor aggregates (Eventbrite/AllEvents list
  ticketed events; trick-or-treat hours are a municipal announcement,
  exactly the category this site claims and they ignore). Villages post
  in late Sept/early Oct and the query peaks in the two weeks before the
  31st, so this ships now, honestly empty of real hours for most or all
  entries, to get indexing lead time - waiting until hours exist would
  mean missing the window the page exists to catch.

  Each entry's `hours` comes from `trick_or_treat:` in that region's own
  YAML (null until the village posts it) - a confidently wrong
  trick-or-treat time is the worst error this site could make, so the
  honest "not yet posted" state is not a placeholder to be embarrassed
  about, it's the correct thing to show until a human confirms real
  hours.

  Styled as its own self-contained page (same pattern as
  about.html.j2/sponsor.html.j2), not extending region.html.j2, which is
  built for a single region's own view.
-->
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Trick-or-Treat Hours {{ year }}: {{ title_towns }} — Within Ten</title>
<meta name="description" content="Official trick-or-treat hours for {{ town_names }}, in one place{% if any_events %}, plus each town's Halloween events{% endif %}.">
<meta property="og:type" content="website">
<meta property="og:site_name" content="Within Ten">
<meta property="og:title" content="Trick-or-Treat Hours {{ year }}: {{ title_towns }} — Within Ten">
<meta property="og:description" content="Official trick-or-treat hours for {{ town_names }}, in one place.">
<meta property="og:image" content="{{ og_image_url }}">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="Trick-or-Treat Hours {{ year }}: {{ title_towns }} — Within Ten">
<meta name="twitter:description" content="Official trick-or-treat hours for {{ town_names }}, in one place.">
<meta name="twitter:image" content="{{ og_image_url }}">
<link rel="canonical" href="{{ canonical_url }}">
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Crect width='100' height='100' fill='%23201e1d'/%3E%3Ctext x='50' y='66' font-family='Arial,sans-serif' font-weight='800' font-size='58' fill='%23ec3013' text-anchor='middle'%3EW%3C/text%3E%3C/svg%3E">
<link rel="manifest" href="{{ hub_url }}manifest.webmanifest">
<link rel="apple-touch-icon" href="{{ hub_url }}icons/icon-192.png">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;600;800&display=optional">
<link href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;600;800&display=optional" rel="stylesheet" media="print" onload="this.media='all'">
<noscript><link href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;600;800&display=optional" rel="stylesheet"></noscript>
<style>
  @view-transition {
    navigation: auto;
  }
  @media (prefers-reduced-motion: reduce) {
    ::view-transition-group(*),
    ::view-transition-old(*),
    ::view-transition-new(*) {
      animation: none !important;
    }
  }
  :root {
    /* ROADMAP.md redesign (2026-09-21): "Modernist" system - see
       region.html.j2's own copy of this block for the full rationale. */
    --bg: #f3f2f2;
    --card: #eae9e9;
    --ink: #201e1d;
    --muted: #605d5d;
    --accent: #ec3013;
    --accent-soft: #cc280d;
    --accent-2-text: #ae1800;
    --border: color-mix(in srgb, var(--ink) 40%, transparent);
    --radius-lg: 0px;
    --shadow-sm: none;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #171615;
      --card: #232120;
      --ink: #f3f2f2;
      --muted: #a9a5a5;
      --accent: #ff563c;
      --accent-soft: #ff563c;
      --accent-2-text: #ff9783;
      --border: color-mix(in srgb, var(--ink) 30%, transparent);
    }
  }
  * { box-sizing: border-box; }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--ink);
    font-family: 'Archivo', system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
  }
  h1, h2 { font-family: 'Archivo', system-ui, sans-serif; font-weight: 800; letter-spacing: -0.02em; }
  .wrap { max-width: 680px; margin: 0 auto; padding: 0 20px 64px; }
  .hero {
    background: var(--bg);
    color: var(--ink);
    padding: 20px 20px 28px;
    margin-bottom: 0;
    border-bottom: 2px solid var(--border);
  }
  .hero-inner { max-width: 680px; margin: 0 auto; }
  a.back { color: var(--muted); text-decoration: none; font-size: 12px; font-weight: 800; letter-spacing: 0.06em; text-transform: uppercase; }
  a.back:hover { color: var(--accent-2-text); }
  .kicker { font-weight: 800; letter-spacing: 0.1em; text-transform: uppercase; font-size: 12px; color: var(--accent-2-text); }
  .hero h1 { margin: 10px 0 8px; font-size: 30px; color: var(--ink); }
  .hero .sub { color: var(--muted); font-size: 15px; max-width: 560px; }
  .entry-list { display: flex; flex-direction: column; gap: 0; margin: 24px 0; }
  .entry {
    background: none;
    border: 0;
    border-bottom: 1px solid var(--border);
    border-radius: 0;
    box-shadow: none;
    padding: 16px 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    flex-wrap: wrap;
  }
  .entry:last-child { border-bottom: 0; }
  .entry .region a { color: var(--ink); font-weight: 700; text-decoration: none; }
  .entry .region a:hover { color: var(--accent-2-text); }
  .entry .hours { font-weight: 700; color: var(--accent-2-text); font-size: 14.5px; text-align: right; }
  .entry .hours a { color: inherit; text-decoration: none; }
  .entry .hours a:hover { text-decoration: underline; }
  .entry .hours-note { display: block; color: var(--muted); font-weight: 400; font-size: 13px; }
  .entry .not-posted { color: var(--muted); font-size: 13.5px; text-align: right; }
  .entry .not-posted a { color: var(--accent-2-text); font-weight: 700; text-decoration: none; }
  .entry .not-posted a:hover { text-decoration: underline; }
  .note { color: var(--muted); font-size: 13.5px; margin: 24px 0; }
  .events-heading { font-size: 22px; margin: 40px 0 0; }
  .town h3 { font-size: 17px; margin: 24px 0 8px; }
  .town h3 a { color: var(--ink); text-decoration: none; }
  .town h3 a:hover { color: var(--accent-2-text); }
  .events { list-style: none; margin: 0; padding: 0; }
  .events li { padding: 6px 0; border-bottom: 1px solid var(--border); font-size: 14.5px; }
  .events li:last-child { border-bottom: 0; }
  .events time { display: inline-block; min-width: 92px; color: var(--muted); font-weight: 600; }
  .events a { color: var(--ink); text-decoration: none; }
  .events a:hover { color: var(--accent-2-text); text-decoration: underline; }
  a:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  footer { text-align: center; color: var(--muted); font-size: 12.5px; margin-top: 32px; border-top: 2px solid var(--border); padding-top: 18px; }
  footer a { color: var(--accent-2-text); font-weight: 700; }
  /* ROADMAP.md item 293: the Halloween look the homepage banner promises -
     fixed colours that read the same in light and dark mode, inline SVG, no
     image files. */
  .tot-hero { position: relative; overflow: hidden; background: radial-gradient(circle at 85% 20%, #3b1d5e 0%, #1a0f2b 55%, #120a1f 100%); color: #fff4e6; border-bottom: 4px solid #ff7a00; padding: 20px 20px 24px; }
  .tot-hero-inner { position: relative; max-width: 680px; margin: 0 auto; display: flex; gap: 16px; align-items: center; }
  .tot-art { flex: 0 0 auto; width: 104px; height: 104px; }
  .tot-art svg { width: 100%; height: 100%; display: block; }
  .tot-hero a.back { color: #d9c2ff; }
  .tot-hero a.back:hover { color: #ffb347; }
  .tot-hero .kicker { color: #ffb347; letter-spacing: 0.14em; }
  .tot-hero h1 { color: #fff; margin: 8px 0 8px; font-size: clamp(22px, 5vw, 30px); line-height: 1.15; }
  .tot-hero .sub { color: #e8dcff; font-size: 15px; }
  .tot-countdown { display: inline-block; margin-top: 10px; background: rgba(255,122,0,.18); border: 1px solid rgba(255,140,26,.6); border-radius: 999px; padding: 3px 12px; font-weight: 800; color: #ffb347; font-size: 14px; }
  .tot-hero .bat { position: absolute; fill: #0b0613; opacity: .9; }
  @media (prefers-reduced-motion: no-preference) {
    .tot-hero .bat { animation: tot-bat 2.4s ease-in-out infinite; transform-origin: center; }
    .tot-hero .bat.b2 { animation-delay: .8s; }
    @keyframes tot-bat { 0%,100% { transform: translateY(0) scaleY(1); } 50% { transform: translateY(-4px) scaleY(.7); } }
  }
  @media (max-width: 480px) { .tot-art { width: 64px; height: 64px; } }
  .entry { border: 1px solid var(--border); border-left: 6px solid var(--town, var(--accent)); background: var(--card); padding: 14px 16px; margin-bottom: 10px; }
  .entry:last-child { border-bottom: 1px solid var(--border); }
  .entry .region a { color: var(--town, var(--ink)); font-size: 17px; }
  .entry .hours { font-size: 17px; }
  .entry .also { flex-basis: 100%; font-size: 13.5px; color: var(--muted); border-top: 1px dashed var(--border); padding-top: 8px; margin-top: 2px; }
  .entry .also a { color: var(--accent-2-text); font-weight: 700; text-decoration: none; }
  .entry .also a:hover { text-decoration: underline; }
  .events .emoji { display: inline-block; width: 1.6em; }
  .share { margin: 4px 0 18px; }
  .share button { font: inherit; font-weight: 800; color: #1a0f2b; background: #ff7a00; border: 0; border-radius: 999px; padding: 9px 18px; cursor: pointer; }
  .share button:hover, .share button:focus-visible { background: #ffa040; }
  .share .copied { margin-left: 10px; color: var(--muted); font-size: 13.5px; }
</style>
{{ signup_css() }}
</head>
<body>
<header class="tot-hero">
  <svg class="bat b1" viewBox="0 0 64 32" width="40" style="top:12px; right:16%;" aria-hidden="true"><path d="M32 12c-2-6-6-8-10-8 2 3 2 6 0 8-3-2-7-2-10 0 1-3 0-6-4-8-4 4-6 10-6 14 4-3 9-3 13 0 2-3 6-4 9-2 3-3 6-4 8-10 2 6 5 7 8 10 3-2 7-1 9 2 4-3 9-3 13 0 0-4-2-10-6-14-4 2-5 5-4 8-3-2-7-2-10 0-2-2-2-5 0-8-4 0-8 2-10 8z"/></svg>
  <svg class="bat b2" viewBox="0 0 64 32" width="26" style="top:46px; right:6%;" aria-hidden="true"><path d="M32 12c-2-6-6-8-10-8 2 3 2 6 0 8-3-2-7-2-10 0 1-3 0-6-4-8-4 4-6 10-6 14 4-3 9-3 13 0 2-3 6-4 9-2 3-3 6-4 8-10 2 6 5 7 8 10 3-2 7-1 9 2 4-3 9-3 13 0 0-4-2-10-6-14-4 2-5 5-4 8-3-2-7-2-10 0-2-2-2-5 0-8-4 0-8 2-10 8z"/></svg>
  <div class="tot-hero-inner">
    <div class="tot-art" aria-hidden="true">
      <svg viewBox="0 0 120 120" xmlns="http://www.w3.org/2000/svg">
        <circle cx="92" cy="26" r="18" fill="#f7e7b4" opacity=".9"/>
        <circle cx="98" cy="22" r="16" fill="#1a0f2b" opacity=".55"/>
        <path d="M60 30c-2-8 2-14 8-16l3 5c-4 2-6 6-5 11z" fill="#4d7c0f"/>
        <ellipse cx="38" cy="72" rx="24" ry="30" fill="#e8620c"/>
        <ellipse cx="82" cy="72" rx="24" ry="30" fill="#e8620c"/>
        <ellipse cx="60" cy="72" rx="26" ry="32" fill="#ff7a00"/>
        <g fill="#ffd166"><path d="M40 62l10-12 8 12z"/><path d="M62 62l8-12 10 12z"/><path d="M56 74l4-6 4 6z"/><path d="M34 82c8 10 44 10 52 0-4 10-12 16-26 16s-22-6-26-16zm12 3v6h6v-5zm16 1v6h6v-6z"/></g>
      </svg>
    </div>
    <div>
      <a class="back" href="{{ hub_url }}">&larr; All regions</a>
      <div class="kicker">🎃 Halloween &middot; {{ halloween_weekday }}, October 31</div>
      <h1>Trick-or-Treat Hours {{ year }}: {{ title_towns }}</h1>
      <div class="sub">Official hours for {{ town_names }}, in one place, each linked to the village page it came from.</div>
      {% if countdown %}<span class="tot-countdown">👻 {{ countdown }}</span>{% endif %}
    </div>
  </div>
</header>

<div class="wrap">
  <main>
  <div class="entry-list">
    {% for entry in entries %}
    <div class="entry" style="--town:{{ entry.color }}">
      <span class="region"><a href="{{ entry.region_url }}">{{ entry.region_name }}</a></span>
      {% if entry.hours %}
      <span class="hours"><a href="{{ entry.url }}">{{ entry.hours }}</a>{% if entry.note %}<span class="hours-note">{{ entry.note }}</span>{% endif %}</span>
      {% elif entry.no_official_hours %}
      <span class="hours"><a href="{{ entry.url }}">No official hours</a>{% if entry.note %}<span class="hours-note">{{ entry.note }}</span>{% endif %}</span>
      {% else %}
      <span class="not-posted">Not yet posted for this year — <a href="{{ entry.url }}">check the village's page</a></span>
      {% endif %}
      {% for x in entry.also or [] %}
      <span class="also">Also: <a href="{{ x.url }}">{{ x.label }}</a>, {{ x.when }}{% if x.place %}, {{ x.place }}{% endif %}</span>
      {% endfor %}
    </div>
    {% endfor %}
  </div>
  <div class="share"><button type="button" id="share-btn">Send this to a neighbour</button><span class="copied" id="share-note" hidden>Link copied</span></div>
  <p class="note">Villages typically post official trick-or-treat hours in late September or early October. Hours are added here once a village posts them, and each one links to the village page it came from. A town showing "not yet posted" has no announcement for this year that we could confirm, so check its page directly.</p>
  {% if trunk_events %}
  <h2 class="events-heading" id="trunk-or-treat">Trunk-or-treats</h2>
  <ul class="events">
    {% for event in trunk_events %}
    <li><span class="emoji" aria-hidden="true">{{ event.emoji }}</span><time datetime="{{ event.date_iso }}">{{ event.date_label }}</time> <a href="{{ event.region_url }}#{{ event.anchor_id }}">{{ event.title }}</a> <span class="hours-note">({{ event.region_name }})</span>{% if event.also_at %} <span class="hours-note">Also at: {% for a in event.also_at %}<a href="{{ event.region_url }}#{{ a.anchor_id }}">{{ a.label }}</a>{% if not loop.last %}, {% endif %}{% endfor %}</span>{% endif %}</li>
    {% endfor %}
  </ul>
  {% endif %}
  {% if any_events %}
  <h2 class="events-heading">Halloween events, town by town</h2>
  {% for entry in town_entries if entry.events %}
  <section class="town" id="{{ entry.region_id }}">
    <h3><a href="{{ entry.region_url }}">{{ entry.region_name }}</a></h3>
    <ul class="events">
      {% for event in entry.events %}
      <li><span class="emoji" aria-hidden="true">{{ event.emoji }}</span><time datetime="{{ event.date_iso }}">{{ event.date_label }}</time> <a href="{{ entry.region_url }}#{{ event.anchor_id }}">{{ event.title }}</a>{% if event.also_at %} <span class="hours-note">Also at: {% for a in event.also_at %}<a href="{{ entry.region_url }}#{{ a.anchor_id }}">{{ a.label }}</a>{% if not loop.last %}, {% endif %}{% endfor %}</span>{% endif %}</li>
      {% endfor %}
    </ul>
  </section>
  {% endfor %}
  <p class="note">Every event above comes from that town's library, park district, or village calendar, and links to its listing on the town's page.</p>
  {% endif %}
  {{ signup_form(newsletter, "newsletter-signup", "bd-email", "town:all", "trick-or-treat", signup_headline) }}
  {{ signup_runtime(newsletter) }}
  <script>
  document.getElementById("share-btn").addEventListener("click", function () {
    var u = {{ canonical_url|tojson }}, n = document.getElementById("share-note");
    if (navigator.share) { navigator.share({ title: document.title, url: u }).catch(function () {}); return; }
    if (navigator.clipboard) navigator.clipboard.writeText(u).then(function () { n.hidden = false; });
    else { n.textContent = u; n.hidden = false; }
  });
  </script>
  </main>

  <footer>
    Curious what else is happening? <a href="{{ hub_url }}">See a live region</a>.
    <a href="{{ preferred_source_url }}" rel="noopener">Add us as a preferred source on Google</a>.
    <br>Generated {{ generated_at }}.
  </footer>
</div>
{% if event_json_ld %}
<script type="application/ld+json">{{ event_json_ld|safe }}</script>
{% endif %}
{% if analytics and analytics.configured %}
<script data-goatcounter="https://{{ analytics.goatcounter_code }}.goatcounter.com/count" async src="//gc.zgo.at/count.js"></script>
{% endif %}
</body>
</html>
