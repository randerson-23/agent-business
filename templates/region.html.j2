<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ region.name }} ({{ region.zip }}) — Weekend Planner</title>
<meta name="description" content="What's happening in {{ region.name }}, {{ region.state }} ({{ region.zip }}): {{ region.tagline }}">
<style>
  :root {
    --bg: #faf8f4;
    --card: #ffffff;
    --ink: #1f2a24;
    --muted: #5c6b63;
    --accent: #2f6b4f;
    --accent-2: #d98a3d;
    --border: #e5e0d6;
    --chip-bg: #eef3ef;
    --chip-active-bg: #2f6b4f;
    --chip-active-ink: #ffffff;
  }
  * { box-sizing: border-box; }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--ink);
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    line-height: 1.5;
  }
  .wrap { max-width: 920px; margin: 0 auto; padding: 28px 20px 64px; }
  a.back { color: var(--muted); text-decoration: none; font-size: 13px; }
  a.back:hover { color: var(--accent); }

  header.site { margin: 18px 0 20px; }
  header.site .kicker {
    display: inline-block;
    color: var(--accent);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-size: 12px;
  }
  header.site h1 { margin: 6px 0 4px; font-size: 28px; }
  header.site .sub { color: var(--muted); font-size: 15px; }

  .sponsor {
    background: linear-gradient(135deg, #fff7ec, #fff);
    border: 1px solid var(--border);
    border-left: 4px solid var(--accent-2);
    border-radius: 10px;
    padding: 14px 16px;
    margin: 20px 0;
  }
  .sponsor .label {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--accent-2);
    font-weight: 700;
    margin-bottom: 4px;
  }
  .sponsor h3 { margin: 0 0 4px; font-size: 16px; }
  .sponsor p { margin: 0; color: var(--muted); font-size: 14px; }
  .sponsor a { color: var(--accent-2); text-decoration: none; font-weight: 600; }

  .filter-bar {
    position: sticky;
    top: 0;
    background: var(--bg);
    padding: 10px 0;
    margin-bottom: 8px;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    z-index: 5;
  }
  .filter-chip {
    border: 1px solid var(--border);
    background: var(--chip-bg);
    color: var(--ink);
    border-radius: 999px;
    padding: 6px 12px;
    font-size: 13px;
    cursor: pointer;
    user-select: none;
    display: inline-flex;
    align-items: center;
    gap: 5px;
  }
  .filter-chip[aria-pressed="true"] {
    background: var(--chip-active-bg);
    color: var(--chip-active-ink);
    border-color: var(--chip-active-bg);
  }
  .filter-chip.clear { background: transparent; border-style: dashed; display: none; }
  .filter-chip.clear.visible { display: inline-flex; }

  section.block { margin-bottom: 26px; }
  section.block h2 {
    font-size: 17px;
    border-bottom: 2px solid var(--border);
    padding-bottom: 8px;
    margin-bottom: 12px;
  }

  .card-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 12px;
  }
  .card {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 14px 16px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .card.hidden { display: none; }
  .card .date { color: var(--accent); font-size: 12.5px; font-weight: 700; }
  .card h3 { margin: 0; font-size: 15.5px; line-height: 1.3; }
  .card h3 a { color: var(--ink); text-decoration: none; }
  .card h3 a:hover { color: var(--accent); }
  .card p.detail { margin: 0; color: var(--muted); font-size: 13.5px; }
  .tag-row { display: flex; flex-wrap: wrap; gap: 5px; margin-top: 2px; }
  .tag-badge {
    font-size: 11.5px;
    background: var(--chip-bg);
    border-radius: 999px;
    padding: 3px 9px;
    color: var(--accent);
    font-weight: 600;
  }
  .empty { color: var(--muted); font-size: 14px; font-style: italic; }

  footer {
    text-align: center;
    color: var(--muted);
    font-size: 12.5px;
    margin-top: 40px;
    border-top: 1px solid var(--border);
    padding-top: 18px;
  }
  footer a { color: var(--accent); }
</style>
</head>
<body>
<div class="wrap">
  <a class="back" href="../">&larr; All regions</a>

  <header class="site">
    <span class="kicker">{{ region.name }} · {{ region.zip }}</span>
    <h1>What's happening in {{ region.name }}</h1>
    <div class="sub">Issue for {{ issue_date }} — {{ region.tagline }}</div>
  </header>

  <div class="sponsor">
    <div class="label">This Week's Sponsor</div>
    <h3>{{ sponsor.title }}</h3>
    <p>{{ sponsor.detail }} {% if sponsor.url %}<a href="{{ sponsor.url }}">Learn more &rarr;</a>{% endif %}</p>
  </div>

  {% if available_tags %}
  <div class="filter-bar" role="group" aria-label="Filter events">
    {% for tag in available_tags %}
    <button type="button" class="filter-chip" data-tag="{{ tag.id }}" aria-pressed="false">
      <span aria-hidden="true">{{ tag.emoji }}</span>{{ tag.label }}
    </button>
    {% endfor %}
    <button type="button" class="filter-chip clear" id="clear-filters">Clear filters</button>
  </div>
  {% endif %}

  {% for block in blocks %}
  <section class="block">
    <h2>{{ block.section }}</h2>
    {% if block.events %}
      <div class="card-grid">
      {% for item in block.events %}
      <div class="card" data-tags="{{ item.tags|join(',') }}">
        {% if item.date %}<div class="date">{{ item.date }}</div>{% endif %}
        <h3>{% if item.url %}<a href="{{ item.url }}">{{ item.title }}</a>{% else %}{{ item.title }}{% endif %}</h3>
        {% if item.detail %}<p class="detail">{{ item.detail }}</p>{% endif %}
        {% if item.tags %}
        <div class="tag-row">
          {% for t in item.tags %}<span class="tag-badge">{{ t.replace('_', ' ') }}</span>{% endfor %}
        </div>
        {% endif %}
      </div>
      {% endfor %}
      </div>
    {% else %}
      <p class="empty">No live updates fetched this week — check back or visit the source directly.</p>
    {% endif %}
  </section>
  {% endfor %}

  <section class="block">
    <h2>Around {{ region.name }}</h2>
    <div class="card-grid">
    {% for item in evergreen %}
    <div class="card" data-tags="{{ item.tags|join(',') }}">
      <h3><a href="{{ item.url }}">{{ item.title }}</a></h3>
      <p class="detail">{{ item.detail }}</p>
      {% if item.tags %}
      <div class="tag-row">
        {% for t in item.tags %}<span class="tag-badge">{{ t.replace('_', ' ') }}</span>{% endfor %}
      </div>
      {% endif %}
    </div>
    {% endfor %}
    </div>
  </section>

  <footer>
    Local business? See the
    <a href="https://github.com/randerson-23/agent-business/blob/main/SPONSOR_KIT.md">sponsor kit</a>.
    <br>Generated {{ generated_at }}.
  </footer>
</div>

<script>
(function () {
  var activeTags = new Set();
  var chips = document.querySelectorAll(".filter-chip[data-tag]");
  var cards = document.querySelectorAll(".card[data-tags]");
  var clearBtn = document.getElementById("clear-filters");

  function apply() {
    cards.forEach(function (card) {
      var tags = (card.getAttribute("data-tags") || "").split(",").filter(Boolean);
      var visible = activeTags.size === 0 || tags.some(function (t) { return activeTags.has(t); });
      card.classList.toggle("hidden", !visible);
    });
    if (clearBtn) clearBtn.classList.toggle("visible", activeTags.size > 0);
  }

  chips.forEach(function (chip) {
    chip.addEventListener("click", function () {
      var tag = chip.getAttribute("data-tag");
      var pressed = chip.getAttribute("aria-pressed") === "true";
      chip.setAttribute("aria-pressed", String(!pressed));
      if (pressed) { activeTags.delete(tag); } else { activeTags.add(tag); }
      apply();
    });
  });

  if (clearBtn) {
    clearBtn.addEventListener("click", function () {
      activeTags.clear();
      chips.forEach(function (chip) { chip.setAttribute("aria-pressed", "false"); });
      apply();
    });
  }
})();
</script>
</body>
</html>
