{# Non-render-blocking font load: paint with the fallback stack immediately,
     swap to the web font once it's fetched, instead of blocking first paint
     on a round trip to fonts.googleapis.com (real measured LCP impact on a
     cold connection was ~300ms - see ROADMAP.md Phase 11 #26). #}
<link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;600;800&display=optional">
<link href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;600;800&display=optional" rel="stylesheet" media="print" onload="this.media='all'">
<noscript><link href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;600;800&display=optional" rel="stylesheet"></noscript>
<style>
  /* Native cross-document View Transitions (ROADMAP.md Phase 11 #20) -
     an unknown at-rule to any browser without support, so this is a
     zero-risk progressive enhancement: nothing to fall back to, nothing
     that can break, just a plain page load where it isn't understood. */
  @view-transition {
    navigation: auto;
  }
  @media (prefers-reduced-motion: reduce) {
    ::view-transition-group(*),
    ::view-transition-old(*),
    ::view-transition-new(*) {
      animation: none !important;
    }
  }
  :root {
    /* ROADMAP.md redesign (2026-09-21): "Modernist" system - flat,
       architectural, set in Archivo: a single mono red accent on a light
       neutral ground, zero corner radius, strong 2px dividers instead of
       soft shadows. --border is derived from --ink via color-mix() so it
       tracks light/dark automatically without a separate override below. */
    --bg: #f3f2f2;
    --card: #eae9e9;
    --ink: #201e1d;
    --muted: #605d5d;
    --accent: #ec3013;
    --accent-soft: #cc280d;
    --accent-2: #ec3013;
    /* Deep ramp step, not the raw accent - the accent-to-ground pair is
       only ~3:1, enough for icons/borders/large text but below WCAG AA's
       4.5:1 for text this small. Use for text; --accent/--accent-2 stay
       for borders and large type where contrast rules don't apply. */
    --accent-2-text: #ae1800;
    --border: color-mix(in srgb, var(--ink) 40%, transparent);
    --radius-lg: 0px;
    --shadow-sm: none;
    --shadow-md: none;
    --shadow-lift: none;
    --callout-gradient: var(--card);
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #171615;
      --card: #232120;
      --ink: #f3f2f2;
      --muted: #a9a5a5;
      --accent: #ff563c;
      --accent-soft: #ff563c;
      --accent-2: #ff563c;
      --accent-2-text: #ff9783;
      --border: color-mix(in srgb, var(--ink) 30%, transparent);
      --callout-gradient: var(--card);
    }
  }
  * { box-sizing: border-box; }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--ink);
    font-family: 'Archivo', system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    line-height: 1.55;
    -webkit-font-smoothing: antialiased;
    min-height: 100vh;
  }
  h1, h2 { font-family: 'Archivo', system-ui, sans-serif; font-weight: 800; letter-spacing: -0.02em; }

  .topnav {
    display: flex;
    align-items: baseline;
    gap: 24px;
    flex-wrap: wrap;
    max-width: 960px;
    margin: 0 auto;
    padding: 14px 20px;
    border-bottom: 2px solid var(--border);
  }
  .topnav .wordmark { font-weight: 800; font-size: 16px; letter-spacing: -0.01em; color: var(--ink); }
  .topnav nav { display: flex; gap: 18px; flex-wrap: wrap; margin-left: auto; }
  .topnav nav a { font-size: 13px; font-weight: 700; color: var(--ink); text-decoration: none; }
  .topnav nav a:hover { color: var(--accent-2-text); }

  .hero {
    background: var(--bg);
    color: var(--ink);
    padding: 44px 20px 40px;
    text-align: left;
    position: relative;
    overflow: hidden;
  }
  .hero-inner { position: relative; max-width: 620px; margin: 0; }
  .brand-mark { display: inline-flex; align-items: center; gap: 8px; margin-bottom: 14px; }
  .brand-mark svg { width: 26px; height: 26px; }
  .kicker {
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    font-size: 12.5px;
    color: var(--accent-2-text);
  }
  .hero h1 {
    margin: 8px 0 12px;
    font-size: clamp(32px, 5vw, 48px);
    color: var(--ink);
    /* Without this the headline breaks as "...ten miles" / "out.",
       orphaning a two-letter word on its own line inside a 620px
       hero-inner. Balanced wrapping evens the lines instead; unsupported
       browsers just get the default greedy wrap, which is what shipped
       before, so there is nothing to fall back to. */
    text-wrap: balance;
  }
  .hero .sub { color: var(--muted); font-size: 16.5px; }

  .wrap { max-width: 960px; margin: 0 auto; padding: 32px 20px 64px; position: relative; }

  /* Bento grid (ROADMAP.md Phase 11 #8): the "this weekend" callout and
     the stat tile, and only those two - region cards used to share this
     same fluid auto-fill grid, which stranded a lone last-row card next
     to an empty gap at 4 regions (recurring at 5/7/8); they now live in
     their own .region-grid below (ROADMAP.md Phase 11 #56), so this grid
     only ever has exactly 2 children and can be a plain fixed 2-column
     layout - no span math needed to keep them proportioned. */
  .bento-grid {
    display: grid;
    grid-template-columns: 2fr 1fr;
    grid-auto-rows: minmax(120px, auto);
    gap: 16px;
    margin-bottom: 18px;
  }
  @media (max-width: 560px) {
    .bento-grid { grid-template-columns: 1fr; }
  }
  /* Region cards: a separate flex-wrap grid, not CSS grid - grid only
     collapses a column TRACK with zero items anywhere in the whole
     grid, not one merely unused in one row, so it can't stretch a lone
     last-row card to fill the gap beside it (confirmed by trying
     grid's auto-fit first and screenshotting the still-stranded card).
     Flexbox distributes flex-grow space per line independently, so a
     lone last-row card genuinely stretches to fill its row instead. */
  .region-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    margin-bottom: 18px;
  }
  .region-grid .region-card {
    flex: 1 1 220px;
  }
  .bento-tile {
    background: var(--card);
    border: 2px solid var(--border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-md);
    padding: 24px;
    text-decoration: none;
    color: var(--ink);
    display: flex;
    flex-direction: column;
    gap: 7px;
    justify-content: center;
    transition: background .12s ease;
    /* Lets a tile's own contents respond to the width the grid track
       actually gives it (see @container rules below) rather than only
       the viewport - the same tile is much wider with 2 regions than
       with 5 (ROADMAP.md Phase 11 #21). */
    container-type: inline-size;
  }
  .bento-tile:hover { background: color-mix(in srgb, var(--ink) 5%, var(--card)); }
  /* Scroll-reveal (ROADMAP.md Phase 11 #9), attempt 2: an
     IntersectionObserver toggles this class once per tile instead of
     animation-timeline: view()'s continuous per-frame scroll-linked
     recalculation, which measurably cost real Total Blocking Time under
     Lighthouse's CPU throttling and got reverted (see item 19's writeup).
     transform only, never opacity - an opacity-based reveal genuinely
     deferred a tile's recorded LCP timestamp last time; a tile is fully
     painted and LCP-eligible immediately regardless of this class. */
  @media (prefers-reduced-motion: no-preference) {
    .bento-tile.js-reveal-ready { transform: translateY(16px); transition: transform .4s ease, background .12s ease; }
    .bento-tile.js-reveal-ready.js-revealed { transform: translateY(0); }
  }
  .bento-weekend {
    background: var(--callout-gradient);
    border: 2px solid var(--accent);
    justify-content: flex-start;
  }
  .bento-weekend .bento-kicker {
    font-weight: 800;
    font-size: 12.5px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--accent-2-text);
  }
  .bento-weekend h2 { margin: 2px 0 0; font-size: 24px; }
  .bento-weekend p { margin: 0; color: var(--accent-2-text); font-weight: 700; font-size: 14.5px; }
  /* ROADMAP.md item 149: deliberately plain flat links, not bento tiles -
     see the comment at the markup for why these two stay lightweight. */
  .hub-secondary-links { display: flex; gap: 20px; flex-wrap: wrap; margin: -6px 0 18px; }
  .hub-secondary-links a {
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--ink);
    text-decoration: none;
    background: none;
    border-bottom: 2px solid var(--border);
    padding: 0 0 4px;
    box-shadow: none;
  }
  .hub-secondary-links a:hover { color: var(--accent-2-text); border-bottom-color: var(--accent); }
  .bento-stat { align-items: center; text-align: center; background: var(--accent-soft); border-color: var(--accent-soft); color: var(--bg); }
  .bento-stat-number { font-family: 'Archivo', system-ui, sans-serif; font-size: 40px; font-weight: 800; line-height: 1; }
  .bento-stat-label { font-size: 12.5px; color: var(--bg); }
  .region-card .zip {
    color: var(--accent-2-text);
    font-weight: 800;
    font-size: 12.5px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .region-card h2 { margin: 0; font-size: 21px; }
  .region-card p { margin: 0; color: var(--muted); font-size: 13.5px; }
  .region-card .count {
    font-size: 12.5px;
    color: var(--accent-2-text);
    font-weight: 700;
    margin-top: 4px;
  }
  /* A region tile only gets this wide when there are few enough regions
     for the grid to hand it extra room - a real example of item 21's
     "one card adapts to whichever column it lands in", not decoration. */
  @container (min-width: 340px) {
    .region-card h2 { font-size: 25px; }
    .region-card p { font-size: 14.5px; }
  }



  .empty-state {
    text-align: center;
    color: var(--muted);
    padding: 40px 0;
    background: var(--card);
    border: 2px solid var(--border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
  }


  a:focus-visible, button:focus-visible, input:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .sr-only {
    position: absolute;
    width: 1px; height: 1px;
    padding: 0; margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  footer {
    text-align: center;
    color: var(--muted);
    font-size: 12.5px;
    margin-top: 48px;
    border-top: 2px solid var(--border);
    padding-top: 18px;
  }
  footer a { color: var(--accent-2-text); font-weight: 700; }

  @media (max-width: 480px) {
    .hero { padding: 32px 18px 28px; }
    .hero h1 { font-size: 28px; }
    .wrap { padding: 24px 14px 48px; }
  }
  /* Halloween banner (owner request 2026-10-13): front and centre from Sept 1
     to Oct 31, in fixed Halloween colours that read
     the same in light and dark mode. Art is inline SVG, no image files. */
  .halloween {
    position: relative; overflow: hidden;
    background: radial-gradient(circle at 85% 20%, #3b1d5e 0%, #1a0f2b 55%, #120a1f 100%);
    color: #fff4e6; border-bottom: 4px solid #ff7a00;
  }
  .halloween-inner { position: relative; max-width: 1080px; margin: 0 auto; padding: 22px 20px 20px; display: flex; gap: 18px; align-items: center; }
  .halloween-art { flex: 0 0 auto; width: 140px; height: 140px; }
  .halloween-art svg { width: 100%; height: 100%; display: block; }
  .halloween-copy { flex: 1 1 auto; min-width: 0; }
  .halloween-kicker { font-size: 12px; font-weight: 800; letter-spacing: 2px; text-transform: uppercase; color: #ffb347; }
  .halloween h2 { margin: 4px 0 10px; font-size: clamp(22px, 4.2vw, 32px); line-height: 1.15; color: #ffffff; }
  .halloween h2 .pumpkin-orange { color: #ff8c1a; }
  .halloween-hours { display: flex; flex-wrap: wrap; gap: 8px; margin: 0 0 14px; padding: 0; list-style: none; }
  .halloween-hours li { background: rgba(255,122,0,.14); border: 1px solid rgba(255,140,26,.55); border-radius: 999px; padding: 4px 12px; font-size: 14px; white-space: nowrap; }
  .halloween-hours li strong { color: #ffb347; font-weight: 800; }
  .halloween-cta { display: inline-block; background: #ff7a00; color: #1a0f2b; font-weight: 800; text-decoration: none; padding: 10px 18px; border-radius: 999px; box-shadow: 0 0 0 3px rgba(255,122,0,.25); }
  .halloween-cta:hover, .halloween-cta:focus-visible { background: #ffa040; }
  .halloween-countdown { display: inline-block; margin-left: 10px; font-weight: 700; color: #d9c2ff; font-size: 14px; }
  .halloween .bat { position: absolute; fill: #0b0613; opacity: .9; }
  @media (prefers-reduced-motion: no-preference) {
    .halloween .bat { animation: bat-flap 2.4s ease-in-out infinite; transform-origin: center; }
    .halloween .bat.b2 { animation-delay: .8s; }
    .halloween .bat.b3 { animation-delay: 1.5s; }
    @keyframes bat-flap { 0%,100% { transform: translateY(0) scaleY(1); } 50% { transform: translateY(-4px) scaleY(.7); } }
    .halloween .jack-glow { animation: jack-glow 3s ease-in-out infinite; }
    @keyframes jack-glow { 0%,100% { opacity: .95; } 50% { opacity: .6; } }
  }
  /* Holiday banner (ROADMAP.md item 285): Nov 1 - Dec 24, fixed winter colours
     (deep green, red, gold) that read the same in light and dark mode. Inline SVG. */
  .holiday {
    position: relative; overflow: hidden;
    background: linear-gradient(135deg, #0f3d2e 0%, #14532d 60%, #7f1d1d 130%);
    color: #fdf6e3; border-bottom: 4px solid #f5c542;
  }
  .holiday-lights { display: block; width: 100%; height: 22px; }
  .holiday-inner { position: relative; max-width: 1080px; margin: 0 auto; padding: 8px 20px 22px; }
  .holiday-kicker { font-size: 12px; font-weight: 800; letter-spacing: 2px; text-transform: uppercase; color: #f5c542; }
  .holiday h2 { margin: 4px 0 10px; font-size: clamp(22px, 4.2vw, 32px); line-height: 1.15; color: #ffffff; }
  .holiday h2 .gold { color: #f5c542; }
  .holiday-dates { display: flex; flex-wrap: wrap; gap: 8px; margin: 0 0 14px; padding: 0; list-style: none; }
  .holiday-dates li { background: rgba(245,197,66,.14); border: 1px solid rgba(245,197,66,.55); border-radius: 999px; padding: 4px 12px; font-size: 14px; white-space: nowrap; }
  .holiday-dates li strong { color: #f5c542; font-weight: 800; }
  .holiday-cta { display: inline-block; background: #f5c542; color: #14301f; font-weight: 800; text-decoration: none; padding: 10px 18px; border-radius: 999px; box-shadow: 0 0 0 3px rgba(245,197,66,.25); margin: 0 10px 8px 0; }
  .holiday-cta:hover, .holiday-cta:focus-visible { background: #ffd966; }
  .holiday-offer { display: inline-block; color: #fdf6e3; font-weight: 700; font-size: 14px; text-decoration: underline; margin-bottom: 8px; }
  .holiday-offer:hover, .holiday-offer:focus-visible { color: #f5c542; }
  @media (prefers-reduced-motion: no-preference) {
    .holiday-lights circle { animation: holiday-twinkle 2.6s ease-in-out infinite; }
    .holiday-lights circle:nth-child(3n+2) { animation-delay: .9s; }
    .holiday-lights circle:nth-child(3n) { animation-delay: 1.7s; }
    @keyframes holiday-twinkle { 0%,100% { opacity: 1; } 50% { opacity: .45; } }
  }
  @media (max-width: 560px) {
    .halloween-inner { flex-direction: column; align-items: flex-start; gap: 10px; padding: 18px 16px; }
    .halloween-art { width: 72px; height: 72px; }
    .halloween-countdown { display: block; margin: 10px 0 0; }
  }
  .winter-strip { background: #e8f1fb; color: #14301f; border-bottom: 2px solid #2563eb; }
  .winter-strip-inner { max-width: 1080px; margin: 0 auto; padding: 10px 20px; font-size: 14.5px; }
  .winter-strip a { color: #1d4ed8; font-weight: 700; }
</style>
{{ signup_css() }}
</head>
<body>
  <div class="topnav">
    <span class="wordmark">WITHIN TEN</span>
    <nav aria-label="Quick links">
      <a href="this-weekend/">This weekend</a>
      <a href="today/">Today</a>
      <a href="free/">Free</a>
      <a href="sponsor/">Sponsor</a>
      <a href="about/">About</a>
    </nav>
  </div>
{% if halloween %}
  <section class="halloween" aria-labelledby="halloween-heading">
    <svg class="bat b1" viewBox="0 0 64 32" width="46" style="top:14px; right:18%;" aria-hidden="true"><path d="M32 12c-2-6-6-8-10-8 2 3 2 6 0 8-3-2-7-2-10 0 1-3 0-6-4-8-4 4-6 10-6 14 4-3 9-3 13 0 2-3 6-4 9-2 3-3 6-4 8-10 2 6 5 7 8 10 3-2 7-1 9 2 4-3 9-3 13 0 0-4-2-10-6-14-4 2-5 5-4 8-3-2-7-2-10 0-2-2-2-5 0-8-4 0-8 2-10 8z"/></svg>
    <svg class="bat b2" viewBox="0 0 64 32" width="30" style="top:52px; right:9%;" aria-hidden="true"><path d="M32 12c-2-6-6-8-10-8 2 3 2 6 0 8-3-2-7-2-10 0 1-3 0-6-4-8-4 4-6 10-6 14 4-3 9-3 13 0 2-3 6-4 9-2 3-3 6-4 8-10 2 6 5 7 8 10 3-2 7-1 9 2 4-3 9-3 13 0 0-4-2-10-6-14-4 2-5 5-4 8-3-2-7-2-10 0-2-2-2-5 0-8-4 0-8 2-10 8z"/></svg>
    <svg class="bat b3" viewBox="0 0 64 32" width="22" style="top:24px; right:4%;" aria-hidden="true"><path d="M32 12c-2-6-6-8-10-8 2 3 2 6 0 8-3-2-7-2-10 0 1-3 0-6-4-8-4 4-6 10-6 14 4-3 9-3 13 0 2-3 6-4 9-2 3-3 6-4 8-10 2 6 5 7 8 10 3-2 7-1 9 2 4-3 9-3 13 0 0-4-2-10-6-14-4 2-5 5-4 8-3-2-7-2-10 0-2-2-2-5 0-8-4 0-8 2-10 8z"/></svg>
    <div class="halloween-inner">
      <div class="halloween-art" aria-hidden="true">
        <svg viewBox="0 0 120 120" xmlns="http://www.w3.org/2000/svg">
          <circle cx="92" cy="26" r="18" fill="#f7e7b4" opacity=".9"/>
          <circle cx="98" cy="22" r="16" fill="#1a0f2b" opacity=".55"/>
          <path d="M60 30c-2-8 2-14 8-16l3 5c-4 2-6 6-5 11z" fill="#4d7c0f"/>
          <ellipse cx="38" cy="72" rx="24" ry="30" fill="#e8620c"/>
          <ellipse cx="82" cy="72" rx="24" ry="30" fill="#e8620c"/>
          <ellipse cx="60" cy="72" rx="26" ry="32" fill="#ff7a00"/>
          <g class="jack-glow" fill="#ffd166">
            <path d="M40 62l10-12 8 12z"/>
            <path d="M62 62l8-12 10 12z"/>
            <path d="M56 74l4-6 4 6z"/>
            <path d="M34 82c8 10 44 10 52 0-4 10-12 16-26 16s-22-6-26-16zm12 3v6h6v-5zm16 1v6h6v-6z"/>
          </g>
        </svg>
      </div>
      <div class="halloween-copy">
        <div class="halloween-kicker">🎃 Halloween &middot; {{ halloween.weekday }}, October 31</div>
        <h2 id="halloween-heading">Trick-or-treat hours for all five towns, <span class="pumpkin-orange">in one place</span></h2>
        <ul class="halloween-hours">
          {% for t in halloween.towns %}<li>{{ t.name }} <strong>{{ t.hours }}</strong>{% if t.post %} <a href="{{ t.post.url }}" style="color:#ffb347;" title="{{ t.post.title }}">posted &rarr;</a>{% endif %}</li>{% endfor %}
        </ul>
        <a class="halloween-cta" href="trick-or-treat/">See hours, trunk-or-treats &amp; Halloween events &rarr;</a>
        <span class="halloween-countdown">👻 {{ halloween.countdown }}</span>
      </div>
    </div>
  </section>
  {% endif %}
{% if holiday %}
  <section class="holiday" aria-labelledby="holiday-heading">
    <svg class="holiday-lights" viewBox="0 0 1200 22" preserveAspectRatio="xMidYMin slice" aria-hidden="true"><path d="M0 4 Q300 20 600 6 T1200 4" stroke="#0a2a1f" stroke-width="2" fill="none"/><circle cx="20" cy="11" r="5" fill="#ef4444"/><circle cx="60" cy="15" r="5" fill="#f5c542"/><circle cx="100" cy="11" r="5" fill="#34d399"/><circle cx="140" cy="15" r="5" fill="#60a5fa"/><circle cx="180" cy="11" r="5" fill="#ef4444"/><circle cx="220" cy="15" r="5" fill="#f5c542"/><circle cx="260" cy="11" r="5" fill="#34d399"/><circle cx="300" cy="15" r="5" fill="#60a5fa"/><circle cx="340" cy="11" r="5" fill="#ef4444"/><circle cx="380" cy="15" r="5" fill="#f5c542"/><circle cx="420" cy="11" r="5" fill="#34d399"/><circle cx="460" cy="15" r="5" fill="#60a5fa"/><circle cx="500" cy="11" r="5" fill="#ef4444"/><circle cx="540" cy="15" r="5" fill="#f5c542"/><circle cx="580" cy="11" r="5" fill="#34d399"/><circle cx="620" cy="15" r="5" fill="#60a5fa"/><circle cx="660" cy="11" r="5" fill="#ef4444"/><circle cx="700" cy="15" r="5" fill="#f5c542"/><circle cx="740" cy="11" r="5" fill="#34d399"/><circle cx="780" cy="15" r="5" fill="#60a5fa"/><circle cx="820" cy="11" r="5" fill="#ef4444"/><circle cx="860" cy="15" r="5" fill="#f5c542"/><circle cx="900" cy="11" r="5" fill="#34d399"/><circle cx="940" cy="15" r="5" fill="#60a5fa"/><circle cx="980" cy="11" r="5" fill="#ef4444"/><circle cx="1020" cy="15" r="5" fill="#f5c542"/><circle cx="1060" cy="11" r="5" fill="#34d399"/><circle cx="1100" cy="15" r="5" fill="#60a5fa"/><circle cx="1140" cy="11" r="5" fill="#ef4444"/><circle cx="1180" cy="15" r="5" fill="#f5c542"/></svg>
    <div class="holiday-inner">
      <div class="holiday-kicker">🎄 The holidays &middot; November &amp; December</div>
      <h2 id="holiday-heading">Tree lightings &amp; holiday events in all five towns, <span class="gold">in one place</span></h2>
      <ul class="holiday-dates">
        {% for t in holiday.towns %}<li>{{ t.name }} <strong>{{ t.date }}</strong></li>{% endfor %}
      </ul>
      <a class="holiday-cta" href="holidays/">See tree lightings &amp; holiday events &rarr;</a>
      {% if holiday.offer and contact_email %}<a class="holiday-offer" href="mailto:{{ contact_email }}?subject=Holiday%20guide%20listing">Local business? List your shop in the holiday guide, $20 &rarr;</a>{% endif %}
    </div>
  </section>
  {% endif %}
{% if winter %}
  <section class="winter-strip" aria-label="Winter break">
    <div class="winter-strip-inner">❄️ <strong>Kids off school?</strong> Winter break camps &amp; activities: {% for l in winter.links %}<a href="{{ l.url }}">{{ l.name }}</a>{% if not loop.last %} &middot; {% endif %}{% endfor %}</div>
  </section>
  {% endif %}
  {# header, not div (ROADMAP.md Phase 11 #62, found by a real axe-core
       audit): everything in the hero previously sat outside any
       landmark - <main> only wraps the content below it. #}
  <header class="hero">
    <div class="hero-inner">
      <div class="brand-mark">
        <svg viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <circle cx="50" cy="50" r="48" fill="color-mix(in srgb, var(--accent) 14%, transparent)"/>
          <path d="M50 22c-13 0-24 10-24 24 0 18 24 36 24 36s24-18 24-36c0-14-11-24-24-24z" fill="var(--ink)"/>
          <circle cx="50" cy="45" r="10" fill="var(--card)"/>
        </svg>
        <span class="kicker">Within Ten &middot; Northwest Suburbs</span>
      </div>
      <h1>Everything worth doing, ten miles out.</h1>
      <div class="sub">Village news, library events and park district programs for {{ region_summaries|length }} towns &mdash; gathered automatically, so your weekend takes five minutes to plan instead of an evening.</div>
    </div>
  </header>

  <div class="wrap">
  <main>
  {% if region_summaries %}

  <div class="bento-grid">
    <a class="bento-tile bento-weekend" href="this-weekend/">
      <span class="bento-kicker">📅 This weekend</span>
      <h2>{{ stats.weekend_date_range }}</h2>
      <p>{{ stats.weekend_count }} thing{{ 's' if stats.weekend_count != 1 else '' }} happening across every region &rarr;</p>
    </a>
    <div class="bento-tile bento-stat">
      <span class="bento-stat-number">{{ stats.region_count }}</span>
      <span class="bento-stat-label">town{{ 's' if stats.region_count != 1 else '' }} · {{ stats.event_count }} live update{{ 's' if stats.event_count != 1 else '' }} this week</span>
    </div>
  </div>

  {# ROADMAP.md item 149: the hub-level /today and /free merged views -
       a lightweight text row rather than two more bento tiles, to keep
       the above-the-fold weight the research pass called out (three
       merged views + four region tiles is already the upper bound for a
       phone screen without these becoming full tiles too). #}
  <div class="hub-secondary-links">
    <a href="today/">📍 Today ({{ stats.today_count }}) &rarr;</a>
    <a href="free/">🎟️ Free things to do ({{ stats.free_count }}) &rarr;</a>
  </div>

  {# A separate flex-wrap grid, not part of .bento-grid above: with CSS
       grid, a lone region card left in the last row (4 regions in a
       3-column grid, and this recurs at 5/7/8) sits next to a stranded
       empty gap - grid only collapses a column TRACK that has zero
       items anywhere in the whole grid, not one that's merely unused in
       one row, so auto-fit couldn't fix this despite first looking like
       the right tool (confirmed by screenshotting that attempt, no
       change). Flexbox distributes flex-grow space per line
       independently, so a lone last-row card genuinely stretches to
       fill its row instead (ROADMAP.md Phase 11 #56). #}
  <div class="region-grid" id="region-grid">
    {% for r in region_summaries %}
    <a class="bento-tile region-card" href="{{ r.path }}">
      <span class="zip">{{ r.zip }} · {{ r.state }}</span>
      <h2>{{ r.name }}</h2>
      <p>{{ r.tagline }}</p>
      <span class="count">{{ r.event_count }} live update{{ 's' if r.event_count != 1 else '' }} this week</span>
    </a>
    {% endfor %}
  </div>
  {% else %}
  <div class="empty-state">No regions configured yet.</div>
  {% endif %}

  {# Only render once signup actually works - showing "(Signup coming
     soon.)" on production pages used to pitch sponsors read as
     unfinished (ROADMAP.md Phase 11 #56). Structurally blocked on
     domain registration; see ROADMAP.md's newsletter cluster. Targets
     a hidden iframe rather than a popup window (item 191) - plain
     HTML, works with no JS, and doesn't leave a reader whose popup
     got blocked with zero feedback. The submit-time swap to the
     pending message is a JS enhancement; the note under the input is
     the no-JS fallback disclosure. #}
  {{ signup_form(newsletter, "newsletter-signup", "bd-email", "town:all", "hub") }}
  {{ signup_runtime(newsletter) }}
  </main>

  <footer>
    Want your ZIP added, or want to sponsor a region?
    <a href="sponsor/">See pricing &amp; availability</a>.
    <a href="about/">About</a>.
    <a href="{{ preferred_source_url }}" rel="noopener">Add us as a preferred source on Google</a>.
    {% if trick_or_treat_in_season %}<a href="trick-or-treat/">Trick-or-treat hours</a>.{% endif %}
    <br>See something wrong or missing? <a href="{{ corrections_cta_url }}">Email us</a> — corrections get made the same week.
    <br>Generated {{ generated_at }}.
    {% if analytics and analytics.configured %}<br>Visits counted with privacy-first, cookie-free analytics — no personal data collected.{% endif %}
  </footer>
  </div>

<script>
(function () {
  // Scroll-reveal via IntersectionObserver (ROADMAP.md Phase 11 #9) - one
  // observer callback per tile, unobserved immediately after, instead of
  // continuously recalculating scroll-linked progress every frame the way
  // animation-timeline: view() did (reverted - see item 19's writeup for
  // the real Total Blocking Time cost that approach had in CI). Guarded
  // on the same feature/preference checks as everything else here.
  if (!("IntersectionObserver" in window)) return;
  if (window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
  var tiles = Array.prototype.slice.call(document.querySelectorAll(".bento-tile"));
  if (!tiles.length) return;
  tiles.forEach(function (tile) { tile.classList.add("js-reveal-ready"); });
  var observer = new IntersectionObserver(
    function (entries) {
      entries.forEach(function (entry) {
        if (!entry.isIntersecting) return;
        entry.target.classList.add("js-revealed");
        observer.unobserve(entry.target);
      });
    },
    { rootMargin: "0px 0px -10% 0px", threshold: 0.1 }
  );
  tiles.forEach(function (tile) { observer.observe(tile); });
})();
</script>
{% if analytics and analytics.configured %}
<script data-goatcounter="https://{{ analytics.goatcounter_code }}.goatcounter.com/count" async src="//gc.zgo.at/count.js"></script>
{% endif %}
</body>
</html>
