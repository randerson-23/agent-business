<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Weekend &amp; Trip Planner — Local Events by ZIP</title>
<meta name="description" content="Plan a weekend or a trip: local events and news across Chicago-area ZIP codes, updated automatically.">
<meta property="og:type" content="website">
<meta property="og:title" content="Weekend &amp; Trip Planner — Local Events by ZIP">
<meta property="og:description" content="Plan a weekend or a trip: local events and news across Chicago-area ZIP codes, updated automatically.">
<meta name="twitter:card" content="summary">
<meta name="twitter:title" content="Weekend &amp; Trip Planner — Local Events by ZIP">
<meta name="twitter:description" content="Plan a weekend or a trip: local events and news across Chicago-area ZIP codes, updated automatically.">
<link rel="canonical" href="{{ canonical_url }}">
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Ccircle cx='50' cy='50' r='46' fill='%231f4d3a'/%3E%3Cpath d='M50 22c-13 0-24 10-24 24 0 18 24 36 24 36s24-18 24-36c0-14-11-24-24-24z' fill='white'/%3E%3Ccircle cx='50' cy='45' r='10' fill='%231f4d3a'/%3E%3C/svg%3E">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
  :root {
    --bg: #f7f4ee;
    --card: #ffffff;
    --ink: #17231c;
    --muted: #5c6b63;
    --accent: #1f4d3a;
    --accent-soft: #2f6b4f;
    --accent-2: #d9772e;
    --border: #e6e1d6;
    --radius-lg: 18px;
    --shadow-sm: 0 1px 2px rgba(23,35,28,.06), 0 1px 1px rgba(23,35,28,.05);
    --shadow-md: 0 10px 28px -10px rgba(23,35,28,.20), 0 2px 6px rgba(23,35,28,.06);
    --shadow-lift: 0 16px 36px -12px rgba(23,35,28,.28), 0 3px 8px rgba(23,35,28,.08);
  }
  * { box-sizing: border-box; }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--ink);
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    line-height: 1.55;
    -webkit-font-smoothing: antialiased;
    min-height: 100vh;
  }
  h1, h2 { font-family: 'Fraunces', Georgia, 'Times New Roman', serif; }

  .hero {
    background: linear-gradient(135deg, var(--accent) 0%, var(--accent-soft) 60%, #4a8a68 100%);
    color: #fff;
    padding: 64px 20px 100px;
    text-align: center;
    position: relative;
    overflow: hidden;
  }
  .hero::before {
    content: "";
    position: absolute;
    inset: 0;
    background-image: radial-gradient(circle at 12% 18%, rgba(255,255,255,.10) 0, transparent 40%),
                       radial-gradient(circle at 88% 82%, rgba(255,255,255,.10) 0, transparent 42%);
    pointer-events: none;
  }
  .hero-inner { position: relative; max-width: 620px; margin: 0 auto; }
  .brand-mark { display: inline-flex; align-items: center; gap: 8px; margin-bottom: 14px; }
  .brand-mark svg { width: 26px; height: 26px; }
  .kicker {
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-size: 12.5px;
    color: rgba(255,255,255,.88);
  }
  .hero h1 { margin: 8px 0 12px; font-size: 40px; font-weight: 600; color: #fff; }
  .hero .sub { color: rgba(255,255,255,.9); font-size: 16.5px; }

  .wrap { max-width: 960px; margin: -56px auto 0; padding: 0 20px 64px; position: relative; }

  .region-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
    gap: 18px;
  }
  .region-card {
    background: var(--card);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-md);
    padding: 24px;
    text-decoration: none;
    color: var(--ink);
    display: flex;
    flex-direction: column;
    gap: 7px;
    transition: transform .15s ease, box-shadow .15s ease;
  }
  .region-card:hover { transform: translateY(-4px); box-shadow: var(--shadow-lift); }
  .region-card .zip {
    color: var(--accent-2);
    font-weight: 700;
    font-size: 12.5px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .region-card h2 { margin: 0; font-size: 21px; font-weight: 600; }
  .region-card p { margin: 0; color: var(--muted); font-size: 13.5px; }
  .region-card .count {
    font-size: 12.5px;
    color: var(--accent);
    font-weight: 700;
    margin-top: 4px;
  }

  .empty-state {
    text-align: center;
    color: var(--muted);
    padding: 40px 0;
    background: var(--card);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
  }

  footer {
    text-align: center;
    color: var(--muted);
    font-size: 12.5px;
    margin-top: 48px;
    border-top: 1px solid var(--border);
    padding-top: 18px;
  }
  footer a { color: var(--accent); font-weight: 600; }

  @media (max-width: 480px) {
    .hero { padding: 48px 18px 84px; }
    .hero h1 { font-size: 30px; }
    .wrap { margin-top: -48px; padding: 0 14px 48px; }
  }
</style>
</head>
<body>
  <div class="hero">
    <div class="hero-inner">
      <div class="brand-mark">
        <svg viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <circle cx="50" cy="50" r="48" fill="rgba(255,255,255,.16)"/>
          <path d="M50 22c-13 0-24 10-24 24 0 18 24 36 24 36s24-18 24-36c0-14-11-24-24-24z" fill="#fff"/>
          <circle cx="50" cy="45" r="10" fill="var(--accent)"/>
        </svg>
        <span class="kicker">Weekend &amp; Trip Planner</span>
      </div>
      <h1>Pick a place</h1>
      <div class="sub">Local news and events by ZIP code — updated automatically, so you can plan a weekend at home or a trip nearby.</div>
    </div>
  </div>

  <div class="wrap">
  {% if region_summaries %}
  <div class="region-grid">
    {% for r in region_summaries %}
    <a class="region-card" href="{{ r.path }}">
      <span class="zip">{{ r.zip }} · {{ r.state }}</span>
      <h2>{{ r.name }}</h2>
      <p>{{ r.tagline }}</p>
      <span class="count">{{ r.event_count }} live update{{ 's' if r.event_count != 1 else '' }} this week</span>
    </a>
    {% endfor %}
  </div>
  {% else %}
  <div class="empty-state">No regions configured yet.</div>
  {% endif %}

  <footer>
    Want your ZIP added, or want to sponsor a region?
    <a href="https://github.com/randerson-23/agent-business/blob/main/SPONSOR_KIT.md">See the sponsor kit</a>.
    <br>Generated {{ generated_at }}.
  </footer>
  </div>
</body>
</html>
