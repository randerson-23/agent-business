<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Weekend &amp; Trip Planner — Local Events by ZIP</title>
<meta name="description" content="Plan a weekend or a trip: local events and news across Chicago-area ZIP codes, updated automatically.">
<meta property="og:type" content="website">
<meta property="og:title" content="Weekend &amp; Trip Planner — Local Events by ZIP">
<meta property="og:description" content="Plan a weekend or a trip: local events and news across Chicago-area ZIP codes, updated automatically.">
<meta name="twitter:card" content="summary">
<meta name="twitter:title" content="Weekend &amp; Trip Planner — Local Events by ZIP">
<meta name="twitter:description" content="Plan a weekend or a trip: local events and news across Chicago-area ZIP codes, updated automatically.">
<link rel="canonical" href="{{ canonical_url }}">
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Ccircle cx='50' cy='50' r='46' fill='%231f4d3a'/%3E%3Cpath d='M50 22c-13 0-24 10-24 24 0 18 24 36 24 36s24-18 24-36c0-14-11-24-24-24z' fill='white'/%3E%3Ccircle cx='50' cy='45' r='10' fill='%231f4d3a'/%3E%3C/svg%3E">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<!-- Non-render-blocking font load: paint with the fallback stack immediately,
     swap to the web font once it's fetched, instead of blocking first paint
     on a round trip to fonts.googleapis.com (real measured LCP impact on a
     cold connection was ~300ms - see ROADMAP.md Phase 11 #26). -->
<link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&family=Inter:wght@400;500;600;700&display=swap">
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" media="print" onload="this.media='all'">
<noscript><link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet"></noscript>
<style>
  /* Native cross-document View Transitions (ROADMAP.md Phase 11 #20) -
     an unknown at-rule to any browser without support, so this is a
     zero-risk progressive enhancement: nothing to fall back to, nothing
     that can break, just a plain page load where it isn't understood. */
  @view-transition {
    navigation: auto;
  }
  @media (prefers-reduced-motion: reduce) {
    ::view-transition-group(*),
    ::view-transition-old(*),
    ::view-transition-new(*) {
      animation: none !important;
    }
  }
  :root {
    --bg: #f7f4ee;
    --card: #ffffff;
    --ink: #17231c;
    --muted: #5c6b63;
    --accent: #1f4d3a;
    --accent-soft: #2f6b4f;
    --accent-2: #d9772e;
    /* Darker than --accent-2 - #d9772e is only 2.9:1 on --bg, below WCAG
       AA's 4.5:1 for text this small. Use for text; --accent-2 stays for
       non-text accents (borders) where contrast rules don't apply. */
    --accent-2-text: #a95c23;
    --border: #e6e1d6;
    --radius-lg: 18px;
    --shadow-sm: 0 1px 2px rgba(23,35,28,.06), 0 1px 1px rgba(23,35,28,.05);
    --shadow-md: 0 10px 28px -10px rgba(23,35,28,.20), 0 2px 6px rgba(23,35,28,.06);
    --shadow-lift: 0 16px 36px -12px rgba(23,35,28,.28), 0 3px 8px rgba(23,35,28,.08);
    --callout-gradient: linear-gradient(135deg, #fff7ec, #fff);
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #121c17;
      --card: #1b2620;
      --ink: #eef2ee;
      --muted: #9db3a8;
      --accent: #57b98a;
      --accent-soft: #237549;
      --accent-2: #f0975a;
      --accent-2-text: #f0975a;
      --border: #2c3a32;
      --shadow-sm: 0 1px 2px rgba(0,0,0,.35), 0 1px 1px rgba(0,0,0,.25);
      --shadow-md: 0 10px 28px -10px rgba(0,0,0,.55), 0 2px 6px rgba(0,0,0,.35);
      --shadow-lift: 0 16px 36px -12px rgba(0,0,0,.65), 0 3px 8px rgba(0,0,0,.4);
      --callout-gradient: linear-gradient(135deg, #2a2318, #1b2620);
    }
  }
  * { box-sizing: border-box; }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--ink);
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    line-height: 1.55;
    -webkit-font-smoothing: antialiased;
    min-height: 100vh;
  }
  h1, h2 { font-family: 'Fraunces', Georgia, 'Times New Roman', serif; }

  .hero {
    background: linear-gradient(135deg, var(--accent) 0%, var(--accent-soft) 60%, #4a8a68 100%);
    color: #fff;
    padding: 64px 20px 100px;
    text-align: center;
    position: relative;
    overflow: hidden;
  }
  .hero::before {
    content: "";
    position: absolute;
    inset: 0;
    background-image: radial-gradient(circle at 12% 18%, rgba(255,255,255,.10) 0, transparent 40%),
                       radial-gradient(circle at 88% 82%, rgba(255,255,255,.10) 0, transparent 42%);
    pointer-events: none;
  }
  .hero-inner { position: relative; max-width: 620px; margin: 0 auto; }
  .brand-mark { display: inline-flex; align-items: center; gap: 8px; margin-bottom: 14px; }
  .brand-mark svg { width: 26px; height: 26px; }
  .kicker {
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-size: 12.5px;
    color: rgba(255,255,255,.88);
  }
  .hero h1 { margin: 8px 0 12px; font-size: 40px; font-weight: 600; color: #fff; }
  .hero .sub { color: rgba(255,255,255,.9); font-size: 16.5px; }

  .wrap { max-width: 960px; margin: -56px auto 0; padding: 0 20px 64px; position: relative; }

  .region-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
    gap: 18px;
  }
  .region-card {
    background: var(--card);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-md);
    padding: 24px;
    text-decoration: none;
    color: var(--ink);
    display: flex;
    flex-direction: column;
    gap: 7px;
    transition: transform .15s ease, box-shadow .15s ease;
  }
  .region-card:hover { transform: translateY(-4px); box-shadow: var(--shadow-lift); }
  .region-card .zip {
    color: var(--accent-2-text);
    font-weight: 700;
    font-size: 12.5px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .region-card h2 { margin: 0; font-size: 21px; font-weight: 600; }
  .region-card p { margin: 0; color: var(--muted); font-size: 13.5px; }
  .region-card .count {
    font-size: 12.5px;
    color: var(--accent);
    font-weight: 700;
    margin-top: 4px;
  }
  .region-card .distance {
    font-size: 12.5px;
    color: var(--accent-2-text);
    font-weight: 700;
  }

  .weekend-callout {
    display: block;
    text-align: center;
    background: var(--callout-gradient);
    border: 1px solid var(--border);
    border-left: 4px solid var(--accent-2);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
    padding: 14px 20px;
    margin-bottom: 18px;
    color: var(--accent);
    font-weight: 700;
    font-size: 14.5px;
    text-decoration: none;
  }
  .weekend-callout:hover { box-shadow: var(--shadow-md); }

  .map-card {
    background: var(--card);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
    padding: 14px 18px 8px;
    margin-bottom: 18px;
  }
  .map-card svg {
    width: 100%;
    height: auto;
    display: block;
    /* SVG root clips to the viewBox by default - the pin labels are
       wider than the padding reserved for them (a long region name at
       text-anchor="middle" extends well past its pin's x position), so
       without this a label near an edge gets cut off mid-word. */
    overflow: visible;
  }
  .map-line { stroke: var(--border); stroke-width: 1.5; stroke-dasharray: 4 3; }
  .map-line-label { font-size: 9px; fill: var(--muted); font-family: 'Inter', sans-serif; }
  .map-pin { fill: var(--accent-soft); stroke: var(--card); stroke-width: 2; }
  .map-pin-label {
    font-size: 11px;
    font-weight: 700;
    fill: var(--ink);
    font-family: 'Inter', sans-serif;
  }
  .map-card a { text-decoration: none; }
  .map-card a:hover .map-pin { fill: var(--accent); }
  .map-card a:hover .map-pin-label { fill: var(--accent); }
  .map-card a:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }

  .distance-bar {
    background: var(--card);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
    padding: 16px 20px;
    margin-bottom: 18px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    font-size: 13.5px;
  }
  .distance-bar button {
    font: inherit;
    font-weight: 600;
    color: #fff;
    background: var(--accent-soft);
    border: none;
    border-radius: 999px;
    padding: 8px 16px;
    cursor: pointer;
  }
  .distance-bar button:hover { filter: brightness(1.15); }
  .distance-bar input[type="text"] {
    font: inherit;
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 7px 12px;
    width: 90px;
  }
  .distance-bar .note { color: var(--muted); font-size: 12px; flex-basis: 100%; }
  .distance-bar .status { color: var(--accent); font-weight: 600; }

  .empty-state {
    text-align: center;
    color: var(--muted);
    padding: 40px 0;
    background: var(--card);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
  }

  .newsletter {
    background: var(--card);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
    padding: 20px 24px;
    margin-top: 18px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
  }
  .newsletter form { display: contents; }
  .newsletter-copy strong { font-size: 15px; }
  .newsletter-copy p { margin: 3px 0 0; color: var(--muted); font-size: 13.5px; }
  .newsletter-pending { font-style: italic; }
  .newsletter-form-row { display: flex; gap: 8px; flex-wrap: wrap; }
  .newsletter-form-row input[type="email"] {
    font: inherit;
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 8px 14px;
    min-width: 200px;
  }
  .newsletter-form-row button {
    font: inherit;
    font-weight: 600;
    color: #fff;
    background: var(--accent-soft);
    border: none;
    border-radius: 999px;
    padding: 8px 18px;
    cursor: pointer;
  }
  .newsletter-form-row button:hover { filter: brightness(1.15); }

  a:focus-visible, button:focus-visible, input:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .sr-only {
    position: absolute;
    width: 1px; height: 1px;
    padding: 0; margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  footer {
    text-align: center;
    color: var(--muted);
    font-size: 12.5px;
    margin-top: 48px;
    border-top: 1px solid var(--border);
    padding-top: 18px;
  }
  footer a { color: var(--accent); font-weight: 600; }

  @media (max-width: 480px) {
    .hero { padding: 48px 18px 84px; }
    .hero h1 { font-size: 30px; }
    .wrap { margin-top: -48px; padding: 0 14px 48px; }
  }
</style>
</head>
<body>
  <div class="hero">
    <div class="hero-inner">
      <div class="brand-mark">
        <svg viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <circle cx="50" cy="50" r="48" fill="rgba(255,255,255,.16)"/>
          <path d="M50 22c-13 0-24 10-24 24 0 18 24 36 24 36s24-18 24-36c0-14-11-24-24-24z" fill="#fff"/>
          <circle cx="50" cy="45" r="10" fill="var(--accent)"/>
        </svg>
        <span class="kicker">Weekend &amp; Trip Planner</span>
      </div>
      <h1>Pick a place</h1>
      <div class="sub">Local news and events by ZIP code — updated automatically, so you can plan a weekend at home or a trip nearby.</div>
    </div>
  </div>

  <div class="wrap">
  {% if region_summaries %}
  <a class="weekend-callout" href="this-weekend/">📅 See what's happening this weekend, across every region &rarr;</a>

  {% if region_map %}
  <div class="map-card">
    <svg viewBox="0 0 {{ region_map.width }} {{ region_map.height }}" role="img" aria-label="Map showing the relative location of every covered town">
      {% for line in region_map.lines %}
      <line x1="{{ line.x1 }}" y1="{{ line.y1 }}" x2="{{ line.x2 }}" y2="{{ line.y2 }}" class="map-line" />
      <text x="{{ line.mid_x }}" y="{{ line.mid_y - 6 }}" class="map-line-label" text-anchor="middle">{{ line.miles }} mi</text>
      {% endfor %}
      {% for pin in region_map.pins %}
      <a href="{{ pin.path }}">
        <text x="{{ pin.x }}" y="{{ pin.y - 14 }}" class="map-pin-label" text-anchor="middle">{{ pin.name }}</text>
        <circle cx="{{ pin.x }}" cy="{{ pin.y }}" r="7" class="map-pin" />
      </a>
      {% endfor %}
    </svg>
  </div>
  {% endif %}

  <div class="distance-bar" id="distance-bar">
    <button type="button" id="use-location">📍 Show distance from me</button>
    <span>or</span>
    <label class="sr-only" for="zip-input">ZIP code</label>
    <input type="text" id="zip-input" placeholder="ZIP code" inputmode="numeric" maxlength="5">
    <button type="button" id="use-zip">Go</button>
    <span class="status" id="distance-status" aria-live="polite"></span>
    <span class="note">Calculated in your browser only — your location is never sent anywhere.</span>
  </div>
  <div class="region-grid" id="region-grid">
    {% for r in region_summaries %}
    <a class="region-card" href="{{ r.path }}" data-lat="{{ r.lat }}" data-lon="{{ r.lon }}">
      <span class="zip">{{ r.zip }} · {{ r.state }}</span>
      <h2>{{ r.name }}</h2>
      <p>{{ r.tagline }}</p>
      <span class="count">{{ r.event_count }} live update{{ 's' if r.event_count != 1 else '' }} this week</span>
      <span class="distance" data-distance-label></span>
    </a>
    {% endfor %}
  </div>
  {% else %}
  <div class="empty-state">No regions configured yet.</div>
  {% endif %}

  {% if newsletter %}
  <div class="newsletter">
    {% if newsletter.configured %}
    <form action="https://buttondown.com/api/emails/embed-subscribe/{{ newsletter.buttondown_username }}" method="post" target="popupwindow" onsubmit="window.open('https://buttondown.com/{{ newsletter.buttondown_username }}', 'popupwindow')">
      <div class="newsletter-copy">
        <strong>{{ newsletter.headline }}</strong>
        <p>{{ newsletter.detail }}</p>
      </div>
      <div class="newsletter-form-row">
        <label class="sr-only" for="bd-email">Email address</label>
        <input type="email" name="email" id="bd-email" placeholder="you@example.com" required>
        <button type="submit">Subscribe</button>
      </div>
    </form>
    {% else %}
    <div class="newsletter-copy">
      <strong>{{ newsletter.headline }}</strong>
      <p>{{ newsletter.detail }} <span class="newsletter-pending">(Signup coming soon.)</span></p>
    </div>
    {% endif %}
  </div>
  {% endif %}

  <footer>
    Want your ZIP added, or want to sponsor a region?
    <a href="sponsor/">See pricing &amp; availability</a>.
    <br>Generated {{ generated_at }}.
    {% if analytics and analytics.configured %}<br>Visits counted with privacy-first, cookie-free analytics — no personal data collected.{% endif %}
  </footer>
  </div>

<script>
(function () {
  var grid = document.getElementById("region-grid");
  if (!grid) return;
  var cards = Array.prototype.slice.call(grid.querySelectorAll(".region-card[data-lat]"));
  var statusEl = document.getElementById("distance-status");
  var useLocationBtn = document.getElementById("use-location");
  var useZipBtn = document.getElementById("use-zip");
  var zipInput = document.getElementById("zip-input");

  // Rough town-center coordinates for nearby ZIPs, for the manual-entry
  // fallback when geolocation is denied/unavailable. Approximate on
  // purpose - good enough to rank nearby towns, not turn-by-turn grade.
  var ZIP_COORDS = {
    "60056": [42.0666, -87.9373], "60005": [42.0883, -87.9806],
    "60004": [42.1067, -87.9806], "60008": [42.0839, -88.0173],
    "60016": [42.0334, -87.8834], "60018": [42.0089, -87.8895],
    "60067": [42.1103, -88.0342], "60074": [42.1367, -88.0384],
    "60193": [42.0334, -88.0834], "60195": [42.0611, -88.0834],
    "60007": [42.0039, -87.9773]
  };

  function haversineMiles(lat1, lon1, lat2, lon2) {
    var toRad = function (d) { return (d * Math.PI) / 180; };
    var R = 3958.8; // Earth radius in miles
    var dLat = toRad(lat2 - lat1);
    var dLon = toRad(lon2 - lon1);
    var a = Math.sin(dLat / 2) * Math.sin(dLat / 2) +
      Math.cos(toRad(lat1)) * Math.cos(toRad(lat2)) *
      Math.sin(dLon / 2) * Math.sin(dLon / 2);
    return R * (2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a)));
  }

  function applyDistances(originLat, originLon) {
    cards.forEach(function (card) {
      var lat = parseFloat(card.getAttribute("data-lat"));
      var lon = parseFloat(card.getAttribute("data-lon"));
      if (isNaN(lat) || isNaN(lon)) return;
      var miles = haversineMiles(originLat, originLon, lat, lon);
      card.setAttribute("data-miles", miles);
      var label = card.querySelector("[data-distance-label]");
      if (label) label.textContent = "≈ " + miles.toFixed(1) + " mi away";
    });
    cards.sort(function (a, b) {
      return parseFloat(a.getAttribute("data-miles")) - parseFloat(b.getAttribute("data-miles"));
    });
    cards.forEach(function (card) { grid.appendChild(card); });
  }

  if (useLocationBtn) {
    useLocationBtn.addEventListener("click", function () {
      if (!navigator.geolocation) {
        statusEl.textContent = "Location isn't available in this browser — try a ZIP instead.";
        return;
      }
      statusEl.textContent = "Locating…";
      navigator.geolocation.getCurrentPosition(
        function (pos) {
          applyDistances(pos.coords.latitude, pos.coords.longitude);
          statusEl.textContent = "Sorted by distance from you.";
        },
        function () {
          statusEl.textContent = "Location wasn't shared — try a ZIP instead.";
        },
        { timeout: 8000 }
      );
    });
  }

  if (useZipBtn && zipInput) {
    useZipBtn.addEventListener("click", function () {
      var zip = zipInput.value.trim();
      var coords = ZIP_COORDS[zip];
      if (!coords) {
        statusEl.textContent = "Don't recognize that ZIP yet — try Show distance from me instead.";
        return;
      }
      applyDistances(coords[0], coords[1]);
      statusEl.textContent = "Sorted by distance from " + zip + " (approximate).";
    });
  }
})();
</script>
{% if analytics and analytics.configured %}
<script data-goatcounter="https://{{ analytics.goatcounter_code }}.goatcounter.com/count" async src="//gc.zgo.at/count.js"></script>
{% endif %}
</body>
</html>
