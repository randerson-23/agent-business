<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Sponsor a Region — Within Ten</title>
<meta name="description" content="Reach local families every week. Pricing and live per-region availability for sponsoring the Within Ten.">
<meta property="og:type" content="website">
<meta property="og:site_name" content="Within Ten">
<meta property="og:title" content="Sponsor a Region — Within Ten">
<meta property="og:description" content="Reach local families every week. Pricing and live per-region availability.">
<meta property="og:image" content="{{ og_image_url }}">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="Sponsor a Region — Within Ten">
<meta name="twitter:description" content="Reach local families every week. Pricing and live per-region availability.">
<meta name="twitter:image" content="{{ og_image_url }}">
<link rel="canonical" href="{{ canonical_url }}">
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Crect width='100' height='100' fill='%23201e1d'/%3E%3Ctext x='50' y='66' font-family='Arial,sans-serif' font-weight='800' font-size='58' fill='%23ec3013' text-anchor='middle'%3EW%3C/text%3E%3C/svg%3E">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<!-- Non-render-blocking font load: paint with the fallback stack immediately,
     swap to the web font once it's fetched, instead of blocking first paint
     on a round trip to fonts.googleapis.com (real measured LCP impact on a
     cold connection was ~300ms - see ROADMAP.md Phase 11 #26). -->
<link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;600;800&display=optional">
<link href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;600;800&display=optional" rel="stylesheet" media="print" onload="this.media='all'">
<noscript><link href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;600;800&display=optional" rel="stylesheet"></noscript>
<style>
  /* Native cross-document View Transitions (ROADMAP.md Phase 11 #20) -
     an unknown at-rule to any browser without support, so this is a
     zero-risk progressive enhancement: nothing to fall back to, nothing
     that can break, just a plain page load where it isn't understood. */
  @view-transition {
    navigation: auto;
  }
  @media (prefers-reduced-motion: reduce) {
    ::view-transition-group(*),
    ::view-transition-old(*),
    ::view-transition-new(*) {
      animation: none !important;
    }
  }
  :root {
    /* ROADMAP.md redesign (2026-09-21): "Modernist" system - see
       region.html.j2's own copy of this block for the full rationale. */
    --bg: #f3f2f2;
    --card: #eae9e9;
    --ink: #201e1d;
    --muted: #605d5d;
    --accent: #ec3013;
    --accent-soft: #ec3013;
    --accent-2: #ec3013;
    --accent-2-text: #ae1800;
    --accent-2-strong: #ae1800;
    --border: color-mix(in srgb, var(--ink) 40%, transparent);
    --radius-lg: 0px;
    --shadow-sm: none;
    --shadow-md: none;
    --shadow-lift: none;
    --status-open-bg: #e2f3e7;   --status-open-ink: #1f6b3c;
    --status-booked-bg: #eef0ee; --status-booked-ink: #4a534d;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #171615;
      --card: #232120;
      --ink: #f3f2f2;
      --muted: #a9a5a5;
      --accent: #ff563c;
      --accent-soft: #ff563c;
      --accent-2: #ff563c;
      --accent-2-text: #ff9783;
      --accent-2-strong: #ae1800;
      --border: color-mix(in srgb, var(--ink) 30%, transparent);
      --status-open-bg: #1d3a26;   --status-open-ink: #8fe0ad;
      --status-booked-bg: #2c332e; --status-booked-ink: #b8c2bc;
    }
  }
  * { box-sizing: border-box; }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--ink);
    font-family: 'Archivo', system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    line-height: 1.55;
    -webkit-font-smoothing: antialiased;
  }
  h1, h2 { font-family: 'Archivo', system-ui, sans-serif; font-weight: 800; letter-spacing: -0.02em; }
  .wrap { max-width: 780px; margin: 0 auto; padding: 0 20px 64px; }

  .hero {
    background: var(--bg);
    color: var(--ink);
    padding: 20px 20px 28px;
    margin-bottom: 0;
    border-bottom: 2px solid var(--border);
  }
  .hero-inner { max-width: 780px; margin: 0 auto; }
  a.back { color: var(--muted); text-decoration: none; font-size: 12px; font-weight: 800; letter-spacing: 0.06em; text-transform: uppercase; }
  a.back:hover { color: var(--accent); }
  .kicker { font-weight: 800; letter-spacing: 0.1em; text-transform: uppercase; font-size: 12px; color: var(--accent-2-text); }
  .hero h1 { margin: 10px 0 8px; font-size: 34px; color: var(--ink); }
  .hero .sub { color: var(--muted); font-size: 15.5px; max-width: 620px; }

  section.block { margin: 30px 0; }
  section.block h2 { font-size: 20px; margin: 0 0 14px; padding-bottom: 8px; border-bottom: 2px solid var(--border); }

  /* flex-wrap, not CSS grid (ROADMAP.md Phase 11 #59): four tiers in a
     three-column grid stranded "Event Promo" alone on row two, same
     defect class fixed on the hub in PR #80. Grid only collapses a
     column track with zero items anywhere in the whole grid, not one
     merely unused in one row - flexbox distributes flex-grow space per
     row independently, so a lone last-row card stretches to fill it. */
  .tier-grid { display: flex; flex-wrap: wrap; gap: 14px; }
  .tier {
    flex: 1 1 220px;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
    padding: 18px 20px;
    transition: background .12s ease;
  }
  .tier:hover { background: color-mix(in srgb, var(--ink) 4%, var(--card)); }
  .tier.recommended { border: 2px solid var(--accent); position: relative; }
  .tier-badge {
    display: inline-block;
    background: var(--accent-2-strong);
    color: var(--bg);
    font-size: 11px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    padding: 2px 9px;
    border-radius: 0;
    margin-bottom: 6px;
  }
  .tier h3 { margin: 0 0 4px; font-size: 16px; font-weight: 800; }
  .tier .price { color: var(--accent-2-text); font-weight: 700; font-size: 14px; margin-bottom: 2px; }
  .tier .gated-by { color: var(--muted); font-size: 11.5px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.03em; margin-bottom: 8px; }
  .tier p.detail { margin: 0; color: var(--muted); font-size: 13.5px; }

  .stat-line {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 18px;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
    padding: 12px 18px;
    color: var(--muted);
    font-size: 13px;
    margin: 0 0 20px;
  }
  .stat-line strong { color: var(--ink); }

  .availability-list { display: flex; flex-direction: column; gap: 10px; }
  .availability-row {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
    padding: 14px 18px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
  }
  .availability-row .region { font-weight: 700; }
  .availability-row .region a { color: var(--ink); text-decoration: none; }
  .availability-row .region a:hover { color: var(--accent); }
  .status { font-size: 13px; font-weight: 700; padding: 4px 12px; border-radius: 0; }
  .status.open { background: var(--status-open-bg); color: var(--status-open-ink); }
  .status.booked { background: var(--status-booked-bg); color: var(--status-booked-ink); }

  .cta {
    display: inline-block;
    background: var(--accent-soft);
    color: var(--bg);
    font-weight: 800;
    text-decoration: none;
    padding: 12px 22px;
    border: 2px solid var(--accent-soft);
    border-radius: 0;
    box-shadow: var(--shadow-sm);
  }
  .cta:hover { background: var(--accent-2-text); border-color: var(--accent-2-text); }

  .note { color: var(--muted); font-size: 13px; }

  a:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }

  footer { text-align: center; color: var(--muted); font-size: 12.5px; margin-top: 44px; border-top: 2px solid var(--border); padding-top: 18px; }
  footer a { color: var(--accent-2-text); font-weight: 700; }
</style>
</head>
<body>
<!-- header, not div (ROADMAP.md Phase 11 #62, found by a real axe-core
     audit): everything in the hero previously sat outside any landmark. -->
<header class="hero">
  <div class="hero-inner">
    <a class="back" href="{{ hub_url }}">&larr; All regions</a>
    <span class="kicker">Sponsor a region</span>
    <h1>Be the local recommendation, not another ad</h1>
    <div class="sub">One business per region at a time — a genuine "we like them" placement, not a banner competing with ten other banners. Membership options from a single week to a full year.</div>
  </div>
</header>

<div class="wrap">
  <main>
  {% if stats %}
  <p class="stat-line">
    <span><strong>{{ stats.region_count }}</strong> region{{ 's' if stats.region_count != 1 else '' }} covered</span>
    <span><strong>{{ stats.event_count }}</strong> live update{{ 's' if stats.event_count != 1 else '' }} indexed this week</span>
    <span>running since {{ stats.since }}</span>
  </p>
  {% endif %}
  <section class="block">
    <h2>Why a recommendation beats an ad</h2>
    <p>Nextdoor found that 79% of neighbors acted on a local recommendation they saw there, 81% of them within days — local recommendations consistently out-rank conventional business directories and ads for trust. That's the model here: your placement reads as "here's a local business worth knowing," not a banner. One business holds a region's slot at a time — whether for a week or a year — so readers see exactly one recommendation, never a wall of ads.</p>
  </section>

  <section class="block">
    <h2>Placements &amp; pricing</h2>
    <p style="color: var(--muted); font-size: 13.5px; margin: 0 0 14px;">Annual Partner is the flagship option — a permanent listing, guide placement, and SEO backlink that work for you year-round instead of needing to be renewed every week. Prefer to start smaller? Weekly Spot and Event Promo get you the same recommendation on a shorter commitment.</p>
    <div class="tier-grid">
      {% for tier in tiers %}
      <div class="tier{{ ' recommended' if tier.recommended else '' }}">
        {% if tier.recommended %}<span class="tier-badge">Recommended</span><br>{% endif %}
        <h3>{{ tier.name }}</h3>
        <div class="price">{{ tier.price }}</div>
        {% if tier.gated_by %}<div class="gated-by">Gated by: {{ tier.gated_by }}</div>{% endif %}
        <p class="detail">{{ tier.detail }}</p>
      </div>
      {% endfor %}
    </div>
    <p class="note" style="margin-top: 12px;">Payment: Venmo/Zelle/check. Annual and month-to-month options — no long-term contract on Weekly Spot or Event Promo, cancel anytime.</p>
    <p class="note" style="margin-top: 8px;"><strong>Founding partner rate:</strong> the first 3 businesses per region get 25% off Annual Partner or Neighborhood Authority, held for your first two years, in exchange for a short testimonial and permission to name you as a founding partner. Ask when you reach out how many spots remain in your region.</p>
  </section>

  <section class="block">
    <h2>This week's availability</h2>
    <div class="availability-list">
      {% for a in availability %}
      <div class="availability-row">
        <span class="region"><a href="{{ a.region_url }}">{{ a.region_name }}</a></span>
        {% if a.booked %}
        <span class="status booked">Sponsored by {{ a.sponsor_title }}</span>
        {% else %}
        <span class="status open">Open this week</span>
        {% endif %}
      </div>
      {% endfor %}
    </div>
    <p class="note" style="margin-top: 12px;">Shows this week's status only — not yet a multi-week calendar. Ask about upcoming weeks when you reach out.</p>
  </section>

  <section class="block">
    <h2>Get started</h2>
    <p>Open an inquiry and we'll follow up to confirm your tier and region, collect your blurb/logo and a one-line "why we recommend you," and set up payment — no design work needed on your end.</p>
    <a class="cta" href="{{ cta_url }}">Open a sponsor inquiry &rarr;</a>
  </section>
  </main>

  <footer>
    Curious what the digest looks like? <a href="{{ hub_url }}">See a live region</a>.
    <a href="{{ hub_url }}about/">About</a>.
    <br>Generated {{ generated_at }}.
    {% if analytics and analytics.configured %}<br>Traffic is tracked with privacy-first, cookie-free analytics — ask for current numbers.{% endif %}
  </footer>
</div>
{% if analytics and analytics.configured %}
<script data-goatcounter="https://{{ analytics.goatcounter_code }}.goatcounter.com/count" async src="//gc.zgo.at/count.js"></script>
{% endif %}
</body>
</html>
