{% from "_signup.html.j2" import signup_css, signup_form, signup_runtime -%}
{# ROADMAP.md item 357: an archived issue served inside the current site wrapper. The email HTML is frozen as it was sent and shown in an iframe, so later wrapper changes never rewrite past issues. #}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="max-image-preview:large">
<title>{{ page_title }}</title>
<meta name="description" content="{{ description }}">
<link rel="canonical" href="{{ canonical_url }}">
<meta property="og:type" content="article">
<meta property="og:site_name" content="Within Ten">
<meta property="og:title" content="{{ page_title }}">
<meta property="og:description" content="{{ description }}">
<meta property="og:image" content="{{ og_image_url }}">
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Crect width='100' height='100' fill='%23201e1d'/%3E%3Ctext x='50' y='66' font-family='Arial,sans-serif' font-weight='800' font-size='58' fill='%23ec3013' text-anchor='middle'%3EW%3C/text%3E%3C/svg%3E">
<style>
  :root { --bg:#f3f2f2; --ink:#201e1d; --muted:#605d5d; --card:#eae9e9; --accent:#ec3013; --accent-soft:#c4280e; --accent-2-text:#ae1800; --radius-lg:0; --border:#c9c5c5; }
  @media (prefers-color-scheme: dark) { :root { --bg:#161413; --ink:#f3f2f2; --muted:#a9a5a5; --card:#242120; --accent-soft:#c4280e; --accent-2-text:#ff8a73; --border:#4a4543; } }
  * { box-sizing: border-box; }
  body { margin:0; background:var(--bg); color:var(--ink); font:16px/1.5 system-ui,-apple-system,"Segoe UI",Roboto,sans-serif; }
  header.site { padding:14px 16px; border-bottom:1px solid var(--border); }
  header.site a { color:var(--ink); font-weight:800; text-decoration:none; }
  .wrap { max-width:680px; margin:0 auto; padding:0 16px 40px; }
  .banner { background:var(--card); border:2px solid var(--ink); padding:12px 16px; margin:16px 0; font-weight:600; }
  .banner a { color:var(--accent-2-text); font-weight:800; }
  h1 { font-size:28px; line-height:1.15; margin:8px 0 12px; }
  .sent { color:var(--muted); margin:0 0 12px; }
  iframe.issue { width:100%; height:2400px; border:1px solid var(--border); background:#fff; display:block; }
  .pager { display:flex; justify-content:space-between; gap:12px; margin:16px 0; }
  .pager a { color:var(--accent-2-text); font-weight:700; }
  .sr-only { position:absolute; width:1px; height:1px; overflow:hidden; clip:rect(0 0 0 0); }
</style>
{{ signup_css() }}
</head>
<body>
<header class="site"><a href="{{ hub_url }}">Within Ten</a> &middot; <a href="{{ hub_url }}issues/" style="font-weight:400;">All issues</a></header>
<div class="wrap">
  <div class="banner">This is the {{ issue_label }} issue. <a href="{{ hub_url }}this-weekend/">See this weekend's events &rarr;</a></div>
  <h1>{{ heading }}</h1>
  <p class="sent">Sent {{ issue_label }}. Shown exactly as it went out.</p>
  <iframe class="issue" title="{{ heading }}: the email as sent" sandbox="allow-same-origin allow-popups allow-popups-to-escape-sandbox" srcdoc="{{ frozen_html }}" onload="try{this.style.height=(this.contentDocument.documentElement.scrollHeight+8)+'px'}catch(e){}"></iframe>
  <nav class="pager" aria-label="Other issues">
    <span>{% if older %}<a href="{{ hub_url }}issues/{{ older.date }}/">&larr; Previous issue</a>{% endif %}</span>
    <span>{% if newer %}<a href="{{ hub_url }}issues/{{ newer.date }}/">Next issue &rarr;</a>{% endif %}</span>
  </nav>
  {{ signup_form(newsletter, "newsletter-signup", "bd-email", "town:all", "archive", "Get this list in your inbox every Thursday.") }}
  {{ signup_runtime(newsletter) }}
</div>
{% if analytics and analytics.configured %}
<script data-goatcounter="https://{{ analytics.goatcounter_code }}.goatcounter.com/count" async src="//gc.zgo.at/count.js"></script>
{% endif %}
</body>
</html>
