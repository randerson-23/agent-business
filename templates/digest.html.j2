<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>60056 Weekly — {{ issue_date }}</title>
<meta name="description" content="What's happening this week in Mount Prospect, IL (60056): village news, library events, and park district programs, in one place.">
<style>
  :root {
    --bg: #faf8f4;
    --card: #ffffff;
    --ink: #1f2a24;
    --muted: #5c6b63;
    --accent: #2f6b4f;
    --accent-2: #d98a3d;
    --border: #e5e0d6;
  }
  * { box-sizing: border-box; }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--ink);
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    line-height: 1.5;
  }
  .wrap { max-width: 680px; margin: 0 auto; padding: 32px 20px 64px; }
  header.site { text-align: center; margin-bottom: 28px; }
  header.site .kicker {
    display: inline-block;
    color: var(--accent);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-size: 12px;
  }
  header.site h1 { margin: 6px 0 4px; font-size: 30px; }
  header.site .sub { color: var(--muted); font-size: 15px; }

  .sponsor {
    background: linear-gradient(135deg, #fff7ec, #fff);
    border: 1px solid var(--border);
    border-left: 4px solid var(--accent-2);
    border-radius: 10px;
    padding: 16px 18px;
    margin-bottom: 28px;
  }
  .sponsor .label {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--accent-2);
    font-weight: 700;
    margin-bottom: 4px;
  }
  .sponsor h3 { margin: 0 0 4px; font-size: 17px; }
  .sponsor p { margin: 0; color: var(--muted); font-size: 14px; }
  .sponsor a { color: var(--accent-2); text-decoration: none; font-weight: 600; }

  section.block { margin-bottom: 30px; }
  section.block h2 {
    font-size: 18px;
    border-bottom: 2px solid var(--border);
    padding-bottom: 8px;
    margin-bottom: 14px;
  }
  .item {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 14px 16px;
    margin-bottom: 10px;
  }
  .item h3 { margin: 0 0 4px; font-size: 15.5px; }
  .item h3 a { color: var(--ink); text-decoration: none; }
  .item h3 a:hover { color: var(--accent); }
  .item .date { color: var(--accent); font-size: 12.5px; font-weight: 600; margin-bottom: 4px; }
  .item p { margin: 0; color: var(--muted); font-size: 14px; }
  .empty { color: var(--muted); font-size: 14px; font-style: italic; }

  footer {
    text-align: center;
    color: var(--muted);
    font-size: 12.5px;
    margin-top: 40px;
    border-top: 1px solid var(--border);
    padding-top: 18px;
  }
  footer a { color: var(--accent); }
</style>
</head>
<body>
<div class="wrap">
  <header class="site">
    <span class="kicker">60056 Weekly</span>
    <h1>What's happening in Mount Prospect</h1>
    <div class="sub">Issue for {{ issue_date }} — village news, library events &amp; park district programs, in one place.</div>
  </header>

  <div class="sponsor">
    <div class="label">This Week's Sponsor</div>
    <h3>{{ sponsor.title }}</h3>
    <p>{{ sponsor.detail }} {% if sponsor.url %}<a href="{{ sponsor.url }}">Learn more &rarr;</a>{% endif %}</p>
  </div>

  {% for block in blocks %}
  <section class="block">
    <h2>{{ block.section }}</h2>
    {% if block.events %}
      {% for item in block.events %}
      <div class="item">
        {% if item.date %}<div class="date">{{ item.date }}</div>{% endif %}
        <h3>{% if item.url %}<a href="{{ item.url }}">{{ item.title }}</a>{% else %}{{ item.title }}{% endif %}</h3>
        {% if item.detail %}<p>{{ item.detail }}</p>{% endif %}
      </div>
      {% endfor %}
    {% else %}
      <p class="empty">No live updates fetched this week — check back or visit the source directly.</p>
    {% endif %}
  </section>
  {% endfor %}

  <section class="block">
    <h2>Around 60056</h2>
    {% for item in evergreen %}
    <div class="item">
      <h3><a href="{{ item.url }}">{{ item.title }}</a></h3>
      <p>{{ item.detail }}</p>
    </div>
    {% endfor %}
  </section>

  <footer>
    Built automatically for Mount Prospect, IL (60056). Local business? See the
    <a href="https://github.com/randerson-23/agent-business/blob/main/SPONSOR_KIT.md">sponsor kit</a>.
    <br>Generated {{ generated_at }}.
  </footer>
</div>
</body>
</html>
