{# ROADMAP.md Phase 11 #92, shared by email_digest.html.j2 and
   combined_email_digest.html.j2 (originally duplicated by hand between
   them - both {% include %} this file now, via the same
   FileSystemLoader Environment scripts/build_digest.py already
   constructs for every render_* function, so a future palette change
   only needs to happen once).

   Forces the light palette back for the two clients with a documented
   hook for defeating a client's own forced dark-mode rewrite. Every
   rule repeats a color already set inline - nothing new to design,
   just restated where these two hooks can see it. !important is
   required: a stylesheet !important rule beats a non-important inline
   style in the CSS cascade, which is the whole mechanism this depends
   on. #}

{% for cls, hex in email_surfaces.items() %}
[data-ogsc] .{{ cls }}, [data-ogsb] .{{ cls }} { background-color:{{ hex }} !important; }
{% endfor %}
{% for cls, hex in email_inks.items() %}
[data-ogsc] .{{ cls }}, [data-ogsb] .{{ cls }} { color:{{ hex }} !important; }
{% endfor %}
[data-ogsc] .wt-border, [data-ogsb] .wt-border { border-color:#d7d3d3 !important; }
@media (prefers-color-scheme: dark) {
{% for cls, hex in email_surfaces.items() %}
  .{{ cls }} { background-color:{{ hex }} !important; }
{% endfor %}
{% for cls, hex in email_inks.items() %}
  .{{ cls }} { color:{{ hex }} !important; }
{% endfor %}
  .wt-border { border-color:#d7d3d3 !important; }
}
