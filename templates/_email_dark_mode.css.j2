{# ROADMAP.md Phase 11 #92, shared by email_digest.html.j2 and
   combined_email_digest.html.j2 (originally duplicated by hand between
   them - both {% include %} this file now, via the same
   FileSystemLoader Environment scripts/build_digest.py already
   constructs for every render_* function, so a future palette change
   only needs to happen once).

   Forces the light palette back for the two clients with a documented
   hook for defeating a client's own forced dark-mode rewrite. Every
   rule repeats a color already set inline - nothing new to design,
   just restated where these two hooks can see it. !important is
   required: a stylesheet !important rule beats a non-important inline
   style in the CSS cascade, which is the whole mechanism this depends
   on. #}
[data-ogsc] .wt-bg, [data-ogsb] .wt-bg { background-color:#f3f2f2 !important; }
[data-ogsc] .wt-card, [data-ogsb] .wt-card { background-color:#eae9e9 !important; }
[data-ogsc] .wt-card-sponsor, [data-ogsb] .wt-card-sponsor { background-color:#fff2ef !important; }
[data-ogsc] .wt-cta-bg, [data-ogsb] .wt-cta-bg { background-color:#ec3013 !important; }
[data-ogsc] .wt-ink, [data-ogsb] .wt-ink { color:#201e1d !important; }
[data-ogsc] .wt-muted, [data-ogsb] .wt-muted { color:#605d5d !important; }
[data-ogsc] .wt-accent, [data-ogsb] .wt-accent { color:#ae1800 !important; }
[data-ogsc] .wt-brand, [data-ogsb] .wt-brand { color:#ae1800 !important; }
[data-ogsc] .wt-border, [data-ogsb] .wt-border { border-color:#d7d3d3 !important; }
@media (prefers-color-scheme: dark) {
  .wt-bg { background-color:#f3f2f2 !important; }
  .wt-card { background-color:#eae9e9 !important; }
  .wt-card-sponsor { background-color:#fff2ef !important; }
  .wt-cta-bg { background-color:#ec3013 !important; }
  .wt-ink { color:#201e1d !important; }
  .wt-muted { color:#605d5d !important; }
  .wt-accent { color:#ae1800 !important; }
  .wt-brand { color:#ae1800 !important; }
  .wt-border { border-color:#d7d3d3 !important; }
}
