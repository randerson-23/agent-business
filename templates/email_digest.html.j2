<!--
  ROADMAP.md Phase 11 #36 - built from scratch, deliberately NOT extending
  region.html.j2. Email clients are not browsers: Outlook (2016-2021)
  renders through Word's engine (no flexbox, no grid - tables only),
  Fraunces/Inter won't load (system fonts only), Gmail clips anything
  over 102KB of HTML, and dark mode is handled inconsistently across
  clients. Every rule below exists because of one of those constraints,
  not by habit.

  Dark mode specifically: rather than build and ship an unverifiable
  per-client dark theme, every color here is set explicitly (bgcolor
  attribute AND inline style, on every cell) so Gmail/Outlook.com's
  auto-invert can't produce broken unreadable combinations - this forces
  a consistent light appearance instead. A true dark variant is real,
  scoped-out future work, not something to fake untested.

  Buttondown appends its own unsubscribe footer automatically on send -
  intentionally not duplicated here.
-->
<!doctype html>
<html lang="en" xmlns="http://www.w3.org/1999/xhtml" xmlns:v="urn:schemas-microsoft-com:vml" xmlns:o="urn:schemas-microsoft-com:office:office">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta http-equiv="X-UA-Compatible" content="IE=edge">
<meta name="color-scheme" content="light">
<meta name="supported-color-schemes" content="light">
<title>{{ region.name }} this weekend — Within Ten</title>
<!--[if mso]>
<noscript>
<xml>
<o:OfficeDocumentSettings>
<o:PixelsPerInch>96</o:PixelsPerInch>
</o:OfficeDocumentSettings>
</xml>
</noscript>
<![endif]-->
</head>
<body style="margin:0; padding:0; background-color:#f6efe1;" bgcolor="#f6efe1">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" bgcolor="#f6efe1" style="background-color:#f6efe1;">
<tr>
<td align="center" style="padding:24px 16px;">
<table role="presentation" width="600" cellpadding="0" cellspacing="0" border="0" style="width:600px; max-width:600px;">

<!-- Wordmark -->
<tr>
<td style="padding:0 8px 16px 8px;">
<span style="font-family:Arial, Helvetica, sans-serif; font-size:13px; font-weight:bold; letter-spacing:1px; color:#526b3f;">WITHIN TEN</span>
</td>
</tr>

<!-- Headline -->
<tr>
<td bgcolor="#fffcf5" style="background-color:#fffcf5; border:1px solid #e6dcc8; border-radius:8px; padding:24px;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
<tr>
<td style="font-family:Georgia, 'Times New Roman', serif; font-size:24px; line-height:1.3; color:#2b2318; padding-bottom:6px;">
This weekend in {{ region.name }}
</td>
</tr>
<tr>
<td style="font-family:Arial, Helvetica, sans-serif; font-size:14px; color:#766a58; padding-bottom:20px;">
{{ weekend_date_range }}
</td>
</tr>

{% if weekend_events %}
{% for event in weekend_events[:6] %}
<tr>
<td style="padding:10px 0; border-top:1px solid #e6dcc8;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
<tr>
<td style="font-family:Arial, Helvetica, sans-serif; font-size:15px; color:#2b2318; padding-bottom:2px;">
<a href="{{ event.url }}" style="color:#2b2318; text-decoration:none; font-weight:bold;">{{ event.title }}</a>
</td>
</tr>
{% if event.date %}
<tr>
<td style="font-family:Arial, Helvetica, sans-serif; font-size:13px; color:#96581f;">
{{ event.date }}
</td>
</tr>
{% endif %}
</table>
</td>
</tr>
{% endfor %}
{% else %}
{% if evergreen_highlights %}
<tr>
<td style="font-family:Arial, Helvetica, sans-serif; font-size:14px; color:#766a58; padding-bottom:10px;">
Nothing new dated for this weekend yet, but a few things worth knowing about:
</td>
</tr>
{% for item in evergreen_highlights %}
<tr>
<td style="padding:8px 0; border-top:1px solid #e6dcc8; font-family:Arial, Helvetica, sans-serif; font-size:15px;">
<a href="{{ item.url }}" style="color:#2b2318; text-decoration:none; font-weight:bold;">{{ item.title }}</a>
</td>
</tr>
{% endfor %}
{% else %}
<tr>
<td style="font-family:Arial, Helvetica, sans-serif; font-size:14px; color:#766a58;">
Nothing dated for this weekend yet — the full guide has what's coming up.
</td>
</tr>
{% endif %}
{% endif %}

</table>
</td>
</tr>

<!-- CTA -->
<tr>
<td align="center" style="padding:20px 0;">
<table role="presentation" cellpadding="0" cellspacing="0" border="0">
<tr>
<td bgcolor="#526b3f" style="background-color:#526b3f; border-radius:6px;">
<a href="{{ region_url }}" style="display:inline-block; padding:12px 28px; font-family:Arial, Helvetica, sans-serif; font-size:14px; font-weight:bold; color:#ffffff; text-decoration:none;">See everything in {{ region.name }}</a>
</td>
</tr>
</table>
</td>
</tr>

{% if sponsor and sponsor.is_active_sponsor %}
<!-- Sponsor recommendation -->
<tr>
<td bgcolor="#fdf3e4" style="background-color:#fdf3e4; border:1px solid #e6dcc8; border-radius:8px; padding:18px 20px;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
<tr>
<td style="font-family:Arial, Helvetica, sans-serif; font-size:11px; font-weight:bold; letter-spacing:0.5px; color:#96581f; padding-bottom:6px;">
LOCAL RECOMMENDATION
</td>
</tr>
<tr>
<td style="font-family:Arial, Helvetica, sans-serif; font-size:15px; color:#2b2318;">
<a href="{{ sponsor.url }}" style="color:#2b2318; text-decoration:none; font-weight:bold;">{{ sponsor.title }}</a>
{% if sponsor.detail %} — {{ sponsor.detail }}{% endif %}
</td>
</tr>
</table>
</td>
</tr>
{% endif %}

<!-- Footer -->
<tr>
<td align="center" style="padding:24px 8px 8px 8px; font-family:Arial, Helvetica, sans-serif; font-size:12px; color:#766a58;">
Within Ten — local events within ten miles, updated automatically.
</td>
</tr>

</table>
</td>
</tr>
</table>
</body>
</html>
