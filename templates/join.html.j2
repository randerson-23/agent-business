{% from "_signup.html.j2" import signup_css, signup_form, signup_runtime -%}
{# ROADMAP.md item 277: single-purpose landing page for traffic sent on purpose (ads, press, outreach). No navigation, filters or map; noindex. Reads utm_source/utm_campaign from the URL into the signup form so each source is counted. #}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>What's on this weekend near you — Within Ten</title>
<meta name="robots" content="noindex, max-image-preview:large">
<meta name="description" content="A free weekly email with what's on this weekend in {{ town_names }}, pulled from each town's own village, library and park district calendars.">
<meta property="og:type" content="website">
<meta property="og:site_name" content="Within Ten">
<meta property="og:title" content="What's on this weekend near you — Within Ten">
<meta property="og:description" content="A free weekly email with what's on this weekend in your town.">
<meta property="og:image" content="{{ og_image_url }}">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="What's on this weekend near you — Within Ten">
<meta name="twitter:description" content="A free weekly email with what's on this weekend in your town.">
<meta name="twitter:image" content="{{ og_image_url }}">
<link rel="canonical" href="{{ canonical_url }}">
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Crect width='100' height='100' fill='%23201e1d'/%3E%3Ctext x='50' y='66' font-family='Arial,sans-serif' font-weight='800' font-size='58' fill='%23ec3013' text-anchor='middle'%3EW%3C/text%3E%3C/svg%3E">
<link rel="manifest" href="{{ hub_url }}manifest.webmanifest">
<link rel="apple-touch-icon" href="{{ hub_url }}icons/icon-192.png">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;600;800&display=optional">
<link href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;600;800&display=optional" rel="stylesheet" media="print" onload="this.media='all'">
<noscript><link href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;600;800&display=optional" rel="stylesheet"></noscript>
<style>
  @view-transition {
    navigation: auto;
  }
  @media (prefers-reduced-motion: reduce) {
    ::view-transition-group(*),
    ::view-transition-old(*),
    ::view-transition-new(*) {
      animation: none !important;
    }
  }
  :root {
    /* ROADMAP.md redesign (2026-09-21): "Modernist" system - see
       region.html.j2's own copy of this block for the full rationale. */
    --bg: #f3f2f2;
    --card: #eae9e9;
    --ink: #201e1d;
    --muted: #605d5d;
    --accent: #ec3013;
    --accent-soft: #cc280d;
    --accent-2-text: #ae1800;
    --border: color-mix(in srgb, var(--ink) 40%, transparent);
    --radius-lg: 0px;
    --shadow-sm: none;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #171615;
      --card: #232120;
      --ink: #f3f2f2;
      --muted: #a9a5a5;
      --accent: #ff563c;
      --accent-soft: #ff563c;
      --accent-2-text: #ff9783;
      --border: color-mix(in srgb, var(--ink) 30%, transparent);
    }
  }
  * { box-sizing: border-box; }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--ink);
    font-family: 'Archivo', system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
  }
  h1, h2 { font-family: 'Archivo', system-ui, sans-serif; font-weight: 800; letter-spacing: -0.02em; }
  .wrap { max-width: 680px; margin: 0 auto; padding: 0 20px 64px; }
  .join-hero { background: #c4280e; color: #fff; padding: 26px 20px 22px; }
  .join-hero-inner { max-width: 680px; margin: 0 auto; }
  .join-hero .kicker { color: #ffe9b3; letter-spacing: 0.14em; }
  .join-hero h1 { color: #fff; font-family: Georgia, 'Times New Roman', serif; font-size: 30px; line-height: 1.15; margin: 10px 0 12px; }
  .join-hero .pill { display: inline-block; background: #ffd23f; color: #201e1d; font-weight: 800; border-radius: 999px; padding: 6px 14px; font-size: 15px; }
  .join-hero .count { font-weight: 800; font-size: 15px; margin-top: 10px; }
  .join-hero .sub { color: #fff; opacity: .92; margin-top: 10px; }
  .pick { display: flex; gap: 14px; padding: 14px 0; border-bottom: 1px solid var(--border); }
  .pick:last-child { border-bottom: 0; }
  .chip { width: 54px; flex: none; text-align: center; font-weight: 800; }
  .chip .dow { color: #fff; font-size: 11px; letter-spacing: 1px; border-radius: 10px 10px 0 0; padding: 3px 0; }
  .chip .day { color: #201e1d; font-family: Georgia, 'Times New Roman', serif; font-size: 22px; line-height: 24px; border-radius: 0 0 10px 10px; padding: 4px 0 5px; }
  .pick-title { font-size: 17px; font-weight: 800; color: var(--ink); text-decoration: none; line-height: 1.3; }
  .pick-title:hover { color: var(--accent-2-text); text-decoration: underline; }
  .pick-meta { font-size: 13.5px; color: var(--muted); margin-top: 3px; }
  .pick-meta strong { color: var(--town-text, var(--ink)); }
  .pick { --town-text: var(--town); }
  @media (prefers-color-scheme: dark) { .pick { --town-text: color-mix(in srgb, var(--town) 45%, #fff); } }
  .badge { display: inline-block; font-size: 12px; font-weight: 700; border: 1px solid var(--border); border-radius: 999px; padding: 1px 9px; margin: 6px 6px 0 0; color: var(--muted); }
  .recent { margin: 24px 0 0; font-weight: 700; }
  .recent a { color: var(--accent-2-text); }
  .hero {
    background: var(--bg);
    color: var(--ink);
    padding: 20px 20px 28px;
    margin-bottom: 0;
    border-bottom: 2px solid var(--border);
  }
  .hero-inner { max-width: 680px; margin: 0 auto; }
  a.back { color: var(--muted); text-decoration: none; font-size: 12px; font-weight: 800; letter-spacing: 0.06em; text-transform: uppercase; }
  a.back:hover { color: var(--accent-2-text); }
  .kicker { font-weight: 800; letter-spacing: 0.1em; text-transform: uppercase; font-size: 12px; color: var(--accent-2-text); }
  .hero h1 { margin: 10px 0 8px; font-size: 30px; color: var(--ink); }
  .hero .sub { color: var(--muted); font-size: 15px; max-width: 560px; }
  .entry-list { display: flex; flex-direction: column; gap: 0; margin: 24px 0; }
  .entry {
    background: none;
    border: 0;
    border-bottom: 1px solid var(--border);
    border-radius: 0;
    box-shadow: none;
    padding: 16px 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    flex-wrap: wrap;
  }
  .entry:last-child { border-bottom: 0; }
  .entry .region a { color: var(--ink); font-weight: 700; text-decoration: none; }
  .entry .region a:hover { color: var(--accent-2-text); }
  .entry .hours { font-weight: 700; color: var(--accent-2-text); font-size: 14.5px; text-align: right; }
  .entry .hours a { color: inherit; text-decoration: none; }
  .entry .hours a:hover { text-decoration: underline; }
  .entry .hours-note { display: block; color: var(--muted); font-weight: 400; font-size: 13px; }
  .entry .not-posted { color: var(--muted); font-size: 13.5px; text-align: right; }
  .entry .not-posted a { color: var(--accent-2-text); font-weight: 700; text-decoration: none; }
  .entry .not-posted a:hover { text-decoration: underline; }
  .note { color: var(--muted); font-size: 13.5px; margin: 24px 0; }
  .events-heading { font-size: 22px; margin: 40px 0 0; }
  .town h3 { font-size: 17px; margin: 24px 0 8px; }
  .town h3 a { color: var(--ink); text-decoration: none; }
  .town h3 a:hover { color: var(--accent-2-text); }
  .events { list-style: none; margin: 0; padding: 0; }
  .events li { padding: 6px 0; border-bottom: 1px solid var(--border); font-size: 14.5px; }
  .events li:last-child { border-bottom: 0; }
  .events time { display: inline-block; min-width: 92px; color: var(--muted); font-weight: 600; }
  .events a { color: var(--ink); text-decoration: none; }
  .events a:hover { color: var(--accent-2-text); text-decoration: underline; }
  a:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  footer { text-align: center; color: var(--muted); font-size: 12.5px; margin-top: 32px; border-top: 2px solid var(--border); padding-top: 18px; }
  footer a { color: var(--accent-2-text); font-weight: 700; }
</style>
{{ signup_css() }}
</head>
<body>
<header class="join-hero">
  <div class="join-hero-inner">
    <span class="kicker">WITHIN TEN · WEEKEND GUIDE</span>
    <h1>What's on this weekend in your town, every Thursday morning</h1>
    {% if weekend_date_range %}<span class="pill">📅 {{ weekend_date_range }}</span>{% endif %}
    {% if event_total %}<div class="count">{{ event_total }} thing{{ 's' if event_total != 1 else '' }} to do{% if town_total > 1 %} in {{ town_total }} towns{% endif %} 👇</div>{% endif %}
    <div class="sub">Free. One email a week. Unsubscribe anytime. Pulled from your village, library and park district.</div>
  </div>
</header>

<div class="wrap">
  <main>
  {{ signup_form(newsletter, "newsletter-signup", "bd-email", "town:all", "join", "Pick your town and get this weekend's events by email.", tag_options=tag_options) }}
  {% if picks %}
  <h2 class="events-heading">This weekend's picks</h2>
  {% for pick in picks %}
  <div class="pick" style="--town:{{ pick.pick_color }}">
    <div class="chip"><div class="dow" style="background:{{ pick.pick_color }}">{{ pick.email_dow or "WKND" }}</div><div class="day" style="background:{{ pick.pick_tint }}">{{ pick.email_daynum or pick.email_emoji }}</div></div>
    <div>
      <span>{{ pick.email_emoji }}</span> <a class="pick-title" href="{{ pick.url }}">{{ pick.title }}</a>
      <div class="pick-meta"><strong>{{ pick.pick_town }}</strong>{% if pick.email_clock %} · {{ pick.email_clock }}{% endif %}{% if pick.email_where %} · {{ pick.email_where }}{% endif %}</div>
      {% for b in pick.email_badges %}<span class="badge">{{ b.emoji }} {{ b.label }}</span>{% endfor %}
    </div>
  </div>
  {% endfor %}
  <p class="recent"><a href="{{ recent_issue_url }}">See a recent issue →</a></p>
  {% endif %}
  {{ signup_runtime(newsletter) }}
  <script>
  var q = new URLSearchParams(location.search);
  ["utm_source", "utm_campaign"].forEach(function (k) {
    var v = q.get(k);
    if (v) document.querySelectorAll('input[name="' + k + '"]').forEach(function (i) { i.value = v.slice(0, 40); });
  });
  </script>
</main>

  <footer>
    <a href="{{ hub_url }}">See the full site</a>. Generated {{ generated_at }}.
  </footer>
</div>
{% if analytics and analytics.configured %}
<script data-goatcounter="https://{{ analytics.goatcounter_code }}.goatcounter.com/count" async src="//gc.zgo.at/count.js"></script>
{% endif %}
</body>
</html>
